<Project>
  <!--
    Central package management: every PackageReference version lives here, project files reference
    packages without a Version. New dependencies must be discussed first (CLAUDE.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <SilkNetVersion>2.22.0</SilkNetVersion>
  </PropertyGroup>

  <!-- Engine -->
  <ItemGroup>
    <PackageVersion Include="Silk.NET" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Assimp" Version="$(SilkNetVersion)" />
    <!-- Windowing and input run on SDL2 (ADR 0003); the GLFW backend packages are not referenced. -->
    <PackageVersion Include="Silk.NET.Input.Sdl" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.MoltenVK.Native" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Windowing.Sdl" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Box2D.NET" Version="3.1.654" />
    <PackageVersion Include="ENet-CSharp" Version="2.4.8" />
    <!-- Localization runtime (.mo catalogs, Plural-Forms evaluation). Pinned: 11.0 is a preview with sparse notes (M9, ADR 0060). -->
    <PackageVersion Include="GetText.NET" Version="[10.0.1]" />
    <PackageVersion Include="ImGui.NET" Version="1.89.9.3" />
    <!-- Audio (M7): SoundFlow (MIT; miniaudio natives for every desktop RID inside the package) and NVorbis
         (MIT, fully managed OGG Vorbis decoding). Pinned exactly; see ADR 0030. -->
    <PackageVersion Include="NVorbis" Version="[0.10.5]" />
    <PackageVersion Include="SoundFlow" Version="[1.4.1]" />
    <!-- Physics (M6): pinned exactly, both APIs change between minors (docs/design/physics.md). -->
    <PackageVersion Include="Jitter2" Version="2.9.0" />
    <PackageVersion Include="StbImageSharp" Version="2.30.15" />
    <PackageVersion Include="Steamworks.NET" Version="2024.8.0" />
  </ItemGroup>

  <!--
    Build-time only: MainframeEngine.Generators (source generator, loaded by the compiler as an analyzer) and its
    tests. Never a runtime dependency of the engine or games. 4.14 runs on the .NET 10 SDK's compiler and newer.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- Examples only -->
  <ItemGroup>
    <PackageVersion Include="Spectre.Console" Version="0.54.1-alpha.0.86" />
  </ItemGroup>

  <!-- Tests and tooling only -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
