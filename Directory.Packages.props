<Project>
  <!--
    Central package management: every PackageReference version lives here, project files reference
    packages without a Version. New dependencies must be discussed first (CLAUDE.md).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <SilkNetVersion>2.23.0</SilkNetVersion>
  </PropertyGroup>

  <!-- Engine -->
  <ItemGroup>
    <PackageVersion Include="Silk.NET.Assimp" Version="$(SilkNetVersion)" />
    <!-- Windowing and input run on SDL2 (ADR 0003); the GLFW backend packages are not referenced. -->
    <PackageVersion Include="Silk.NET.Input.Sdl" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.MoltenVK.Native" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.EXT" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Vulkan.Extensions.KHR" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Silk.NET.Windowing.Sdl" Version="$(SilkNetVersion)" />
    <PackageVersion Include="Box2D.NET" Version="3.1.654" />
    <PackageVersion Include="ENet-CSharp" Version="2.4.8" />
    <!-- Localization runtime (.mo catalogs, Plural-Forms evaluation). Pinned: 11.0 is a preview with sparse notes (M9, ADR 0060). -->
    <PackageVersion Include="GetText.NET" Version="[10.0.1]" />
    <!-- Audio (M7): SoundFlow (MIT; miniaudio natives for every desktop RID inside the package) and NVorbis
         (MIT, fully managed OGG Vorbis decoding). Pinned exactly; see ADR 0030. -->
    <PackageVersion Include="NVorbis" Version="[0.10.5]" />
    <PackageVersion Include="SoundFlow" Version="[1.4.1]" />
    <!-- Physics (M6): pinned exactly, both APIs change between minors (docs/design/physics.md). -->
    <PackageVersion Include="Jitter2" Version="2.9.0" />
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <!--
      BRUTAL (Ahwoo Limited, ADR 0192): pinned exactly, because upstream dependency ranges are minimum-only and the API is
      experimental. Upgrades are their own PRs with the full test run. Jolt is referenced from B1 so its natives, notices
      and package size are settled before B3 writes code.
    -->
    <PackageVersion Include="Ahwoo.BRUTAL.Collections" Version="[2026.10.1]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Core" Version="[2026.10.1]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Interop" Version="[2026.10.1]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Jolt" Version="[2026.10.2]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Logging" Version="[2026.10.2]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Memory" Version="[2026.10.1]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Numerics" Version="[2026.10.1]" />
    <PackageVersion Include="Ahwoo.BRUTAL.Strings" Version="[2026.10.1]" />
    <!-- BRUTAL's third-party dependencies (Ahwoo.BRUTAL.Core / Logging), pinned centrally (ADR 0192, THIRD_PARTY_NOTICES.md). -->
    <PackageVersion Include="CommunityToolkit.HighPerformance" Version="[8.4.2]" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="[10.0.0]" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="[10.0.0]" />
    <!-- A preview, because Ahwoo.BRUTAL.Strings 2026.10.1 depends on it; approved and pinned exactly (ADR 0192). -->
    <PackageVersion Include="Microsoft.Extensions.ObjectPool" Version="[11.0.0-preview.5.26302.115]" />
  </ItemGroup>

  <!--
    Build-time only: MainframeEngine.Generators (source generator, loaded by the compiler as an analyzer) and its
    tests. Never a runtime dependency of the engine or games. 5.9 needs the compiler of SDK 10.0.401 or newer
    (global.json, also in the game template).
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

  <!-- Editor only (MainframeEngine.Video: speech recognition for the video editor; never referenced by the runtime) -->
  <ItemGroup>
    <PackageVersion Include="Whisper.net" Version="[1.9.1]" />
    <PackageVersion Include="Whisper.net.Runtime" Version="[1.9.1]" />
  </ItemGroup>

  <!-- Examples only -->
  <ItemGroup>
  </ItemGroup>

  <!-- Tests and tooling only -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>
</Project>
