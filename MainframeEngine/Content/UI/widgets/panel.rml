<template name="mf-panel" content="mf-panel-content">
<head>
    <!--
      Panel window template. In a document head:  <link type="text/template" href="/Content/UI/widgets/panel.rml"/>
      then:  <body template="mf-panel"> ... </body>  — the body content goes into the panel; UiDocument writes the
      document's <title> into the title bar, which also drags the window. Size and place the window through the body
      (e.g. body { left: 40dp; top: 40dp; width: 320dp; }).
    -->
    <link type="text/rcss" href="widgets.rcss"/>
    <style>
        body {
            position: absolute;
            width: 320dp;
            padding: 0dp;
            background-color: #121722f0;
            border: 1dp #2e3850;
            border-radius: 8dp;
            box-shadow: #00000099 0dp 6dp 16dp 0dp;
            pointer-events: auto;
        }
        #mf-panel-bar {
            display: block;
            padding: 8dp 12dp;
            background-color: #1c2333;
            border-bottom: 1dp #2e3850;
            border-radius: 8dp 8dp 0dp 0dp;
            cursor: move;
        }
        #mf-panel-title {
            font-weight: bold;
            color: #ffffff;
        }
        #mf-panel-content {
            display: block;
            padding: 12dp;
        }
    </style>
</head>
<body>
    <handle move_target="#document" id="mf-panel-bar"><span id="mf-panel-title">Panel</span></handle>
    <div id="mf-panel-content"></div>
</body>
</template>
