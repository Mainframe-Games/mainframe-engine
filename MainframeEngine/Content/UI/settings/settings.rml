<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="/Content/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="settings.rcss"/>
</head>
<!--
  The engine's drop-in settings menu (SettingsMenu, docs/design/game-ui.md#settings-menu). Games can copy this file into
  their own Content/ and set SettingsMenuOptions.Source; the "settings" data model below is the contract:

  tab (string: audio | controls | display), showAudio, showControls, showDisplay (bool)
  buses: [ { name, label, volume (0-1, two-way), percent, muted } ]
  actions: [ { label, key1, key2, pad, capturing (-1 none, 0/1 key slots, 2 gamepad), locked } ]
  notice (string: the last rebind conflict or hint)
  windowMode, windowSize, maxFps, shadows, language (strings, two-way), vsync (bool, two-way), uiScale (0.75-2, two-way)
  uiScalePercent (int), showWindow (bool: desktop), windowSizes, maxFpsOptions ([ { value, label } ]), locales ([ { code, name } ])
  shadowsRestart (bool), revertPending (bool), revertText (string: "Reverting in 12 s")
  Events: tab(name), toggleMute(index), rebind(action, class, slot), reset(section), keep(), revert(), close()
-->
<body data-model="settings">
    <div id="settings" class="panel">
        <div class="panel-title">
            <span>Settings</span>
            <button id="settings-close" class="icon" title="Close" data-event-click="close()">×</button>
        </div>

        <div class="tabs">
            <button data-if="showAudio" data-attr-class="tab == 'audio' ? 'tab active' : 'tab'" data-event-click="tab('audio')">Audio</button>
            <button data-if="showControls" data-attr-class="tab == 'controls' ? 'tab active' : 'tab'" data-event-click="tab('controls')">Controls</button>
            <button data-if="showDisplay" data-attr-class="tab == 'display' ? 'tab active' : 'tab'" data-event-click="tab('display')">Display</button>
        </div>

        <!-- ── Audio ─────────────────────────────────────────────────────────── -->
        <div class="page" data-if="tab == 'audio'">
            <div class="setting" data-for="b, i : buses" data-class-muted="b.muted">
                <span class="label no-tr">{{ b.label }}</span>
                <input type="range" min="0" max="1" step="0.01" data-value="b.volume"/>
                <span class="value no-tr">{{ b.percent }}%</span>
                <button data-attr-class="b.muted ? 'mute on' : 'mute'" data-event-click="toggleMute(i)">Mute</button>
            </div>
            <p class="hint">Volumes scale each bus on top of the game's mix; 0% is silent.</p>
            <div class="footer">
                <button data-event-click="reset('audio')">Defaults</button>
                <button class="primary" data-event-click="close()">Done</button>
            </div>
        </div>

        <!-- ── Controls ──────────────────────────────────────────────────────── -->
        <div class="page" data-if="tab == 'controls'">
            <div class="setting header">
                <span class="label">Action</span>
                <span class="keys">Keys / mouse</span>
                <span class="pad">Gamepad</span>
            </div>
            <div id="actions">
                <div class="setting" data-for="a, i : actions" data-class-capturing="a.capturing >= 0" data-class-locked="a.locked">
                    <span class="label no-tr">{{ a.label }}</span>
                    <button class="binding no-tr" data-class-active="a.capturing == 0" data-event-click="rebind(i, 0, 0)">{{ a.capturing == 0 ? '…' : a.key1 }}</button>
                    <button class="binding no-tr" data-class-active="a.capturing == 1" data-event-click="rebind(i, 0, 1)">{{ a.capturing == 1 ? '…' : a.key2 }}</button>
                    <button class="binding pad no-tr" data-class-active="a.capturing == 2" data-event-click="rebind(i, 1, 0)">{{ a.capturing == 2 ? '…' : a.pad }}</button>
                </div>
            </div>
            <p class="hint no-tr">{{ notice }}</p>
            <div class="footer">
                <button data-event-click="reset('controls')">Reset controls</button>
                <button class="primary" data-event-click="close()">Done</button>
            </div>
        </div>

        <!-- ── Display ───────────────────────────────────────────────────────── -->
        <div class="page" data-if="tab == 'display'">
            <div class="setting" data-if="showWindow">
                <span class="label">Window mode</span>
                <select data-value="windowMode">
                    <option value="Windowed">Windowed</option>
                    <option value="Maximized">Maximized</option>
                    <option value="Fullscreen">Fullscreen</option>
                </select>
            </div>
            <div class="setting" data-if="showWindow" data-class-disabled="windowMode != 'Windowed'">
                <span class="label">Window size</span>
                <select data-value="windowSize">
                    <option class="no-tr" data-for="s : windowSizes" data-attr-value="s">{{ s }}</option>
                </select>
            </div>
            <div class="setting">
                <span class="label">VSync</span>
                <input type="checkbox" data-checked="vsync"/>
            </div>
            <div class="setting" data-class-disabled="vsync">
                <span class="label">Max FPS</span>
                <select data-value="maxFps">
                    <option class="no-tr" data-for="f : maxFpsOptions" data-attr-value="f.value">{{ f.label }}</option>
                </select>
            </div>
            <div class="setting">
                <span class="label">UI scale</span>
                <input type="range" min="0.75" max="2" step="0.05" data-value="uiScale"/>
                <span class="value no-tr">{{ uiScalePercent }}%</span>
            </div>
            <div class="setting">
                <span class="label">Shadows</span>
                <select data-value="shadows">
                    <option value="Off">Off</option>
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                </select>
            </div>
            <p class="hint" data-if="shadowsRestart">Turning shadows on or off applies after a restart.</p>
            <div class="setting">
                <span class="label">Language</span>
                <select data-value="language">
                    <option class="no-tr" data-for="l : locales" data-attr-value="l.code">{{ l.name }}</option>
                </select>
            </div>
            <div id="revert" data-if="revertPending">
                <div class="question">
                    <span>Keep this display mode?</span>
                    <span class="hint no-tr">{{ revertText }}</span>
                </div>
                <button class="primary" data-event-click="keep()">Keep</button>
                <button data-event-click="revert()">Revert</button>
            </div>
            <div class="footer">
                <button data-event-click="reset('display')">Defaults</button>
                <button class="primary" data-event-click="close()">Done</button>
            </div>
        </div>
    </div>
    <div id="tooltip"/>
</body>
</rml>
