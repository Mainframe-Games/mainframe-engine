<rml>
<head>
    <style>
        /* A HUD: clicks pass through to the game (as widgets.rcss's body.hud), so a click recaptures the mouse. */
        body { font-family: "Roboto Mono"; width: 100%; height: 100%; pointer-events: none; }
        div { display: block; }
        #fps {
            position: absolute;
            top: 12dp;
            right: 12dp;
            width: 240dp;
            padding: 6dp 10dp;
                        background-color: rgba(7, 6, 13, 170);
            border-left: 2dp #ff2a9d;
            color: #19e6ff;
            font-size: 16dp;
            text-align: right;
            white-space: nowrap;
            pointer-events: none;
        }
        #fps .ms { color: #8fa3b8; font-size: 12dp; }
    </style>
</head>
<body class="hud" data-model="fps">
    <div id="fps">
        <div>{{fps | format(0)}} FPS</div>
        <div class="ms">{{ms | format(1)}} ms · max {{max | format(1)}} ms</div>
    </div>
</body>
</rml>
