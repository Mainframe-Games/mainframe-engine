{
  "format": 4,
  "name": "Neon Demo",
  "engineVersion": "0.0.0-dev",
  "mainScene": "Assets/Scenes/neon.mscene",
  "assemblies": ["Neon"],
  "window": {
    "width": 1920, "height": 1080, "vsync": true, "contentScale": 1, "icon": "Assets/Brand/icon.png"
  },
  "physics": { "ticksPerSecond": 60, "maxStepsPerFrame": 5, "3d": { "gravity": [0, -9.81, 0] } },
  "input": {
    "move_forward": { "label": "Move forward", "deadzone": 0.2, "bindings": ["key:W", "key:Up", "axis:LeftY-"] },
    "move_back": { "label": "Move back", "deadzone": 0.2, "bindings": ["key:S", "key:Down", "axis:LeftY+"] },
    "move_left": { "label": "Move left", "deadzone": 0.2, "bindings": ["key:A", "key:Left", "axis:LeftX-"] },
    "move_right": { "label": "Move right", "deadzone": 0.2, "bindings": ["key:D", "key:Right", "axis:LeftX+"] },
    "look_left": { "label": "Look left", "deadzone": 0, "bindings": ["axis:RightX-"] },
    "look_right": { "label": "Look right", "deadzone": 0, "bindings": ["axis:RightX+"] },
    "look_up": { "label": "Look up", "deadzone": 0, "bindings": ["axis:RightY-"] },
    "look_down": { "label": "Look down", "deadzone": 0, "bindings": ["axis:RightY+"] },
    "sprint": { "label": "Sprint", "bindings": ["key:ShiftLeft", "key:ShiftRight"] },
    "sprint_toggle": { "label": "Sprint (toggle)", "bindings": ["pad:LeftStick"] },
    "crouch": { "label": "Crouch", "bindings": ["key:C", "key:ControlLeft", "key:ControlRight"] },
    "crouch_toggle": { "label": "Crouch (toggle)", "bindings": ["pad:B"] },
    "jump": { "label": "Jump", "bindings": ["key:Space", "pad:A"] },
    "interact": { "label": "Use", "bindings": ["key:E", "pad:X"] },
    "pause": { "label": "Menu", "bindings": ["key:Escape", "pad:Start"] },
    "photo": { "label": "Photo", "bindings": ["key:F2", "pad:Back"] }
  },
  "rendering": { "shadows": "High", "antiAliasing": "Taa" },
  "audio": { "busLayout": "Assets/Settings/AudioBusLayout.mres" },
  "ui": { "scaleMode": "ScaleWithScreenSize", "referenceResolution": [1920, 1080], "matchWidthOrHeight": 1 }
}
