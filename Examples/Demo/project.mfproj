{
  "format": 5,
  "name": "Mainframe Demo",
  "userDataName": "MainframeDemo",
  "engineVersion": "0.0.0-dev",
  "mainScene": "Assets/Scenes/basic_3d.mscene",
  "assemblies": ["Demo"],
  "window": {
    "title": "Mainframe Engine — Demo",
    "width": 1280, "height": 720, "vsync": true,
    "icon": "Assets/icon.png",
    "stretchMode": "canvas_items", "stretchAspect": "expand"
  },
  "physics": { "ticksPerSecond": 60, "maxStepsPerFrame": 5, "3d": { "gravity": [0, -9.81, 0] } },
  "input": {
    "scene_next": { "bindings": ["key:PageDown", "pad:RightBumper"], "label": "Next scene", "group": "nav" },
    "scene_prev": { "bindings": ["key:PageUp", "pad:LeftBumper"], "label": "Previous scene", "group": "nav" },
    "settings": { "bindings": ["key:F10", "pad:Start"], "label": "Settings", "group": "nav" },
    "quit": { "bindings": ["key:Escape"], "label": "Quit", "group": "nav", "rebindable": false },
    "drop": { "bindings": ["mouse:Left", "axis:RightTrigger+"], "label": "Drop crate", "group": "physics" },
    "rain": { "bindings": ["key:R", "pad:Y"], "label": "Rain crates", "group": "physics" }
  },
  "saves": { "backups": 2, "thumbnails": true },
  "audio": { "busLayout": "Assets/Settings/AudioBusLayout.mres" },
  "localization": { "sourceLocale": "en", "fallbacks": [], "directory": "Assets/locale" },
  "rendering": { "shadows": "High" },
  "ui": { "scaleMode": "ScaleWithScreenSize", "referenceResolution": [1280, 720], "matchWidthOrHeight": 1 },
  "autoloads": [ { "name": "Nav", "type": "DemoNavLayer" } ],
  "export": [
    { "name": "Windows", "platform": "windows", "rid": "win-x64", "output": "export/windows" },
    { "name": "macOS", "platform": "macos", "rid": "osx-arm64", "output": "export/macos", "bundleId": "com.mainframegames.demo",
      "copyright": "© Mainframe Games" },
    { "name": "Linux", "platform": "linux", "rid": "linux-x64", "output": "export/linux" },
    { "name": "Linux server", "platform": "linux", "rid": "linux-x64", "output": "export/server", "archive": false, "exe": "MainframeDemoServer",
      "exclude": ["Assets/**/*.po", "Assets/**/*.pot", "Assets/Music/**"] }
  ]
}
