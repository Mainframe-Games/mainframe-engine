<Project>
  <!-- Settings shared by Demo and Demo.Desktop. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The engine checkout this game builds against (the folder holding MainframeEngine.slnx). -->
    <MainframeEnginePath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '../..'))))</MainframeEnginePath>
  </PropertyGroup>
</Project>
