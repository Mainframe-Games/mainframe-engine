<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="navmesh2d">
    <div class="demo-panel">
        <h1>Navigation Mesh 2D</h1>
        <p class="hint">Polygons baked round slanted walls, pillars and a carved pond, funnel paths to the clicked point, and two ferries: links the chasers hop across to the far bank.</p>
        <div class="demo-row"><span>Carve the pond</span><input type="checkbox" data-checked="pond"/></div>
        <div class="demo-row"><span>Visible navigation</span><input type="checkbox" data-checked="debug"/></div>
        <div class="demo-row"><span>Avoidance</span><input type="checkbox" data-checked="avoidance"/></div>
        <div class="demo-row"><span>Polygons</span><span>{{polygons}}</span></div>
        <div class="demo-row"><button data-event-click="rebake()">Bake again</button><span>{{bake}}</span></div>
        <div class="demo-row"><span>Ferry crossings</span><span>{{crossings}}</span></div>
        <div class="demo-row"><span>Arrived</span><span>{{arrived}} / {{total}}</span></div>
    </div>
</body>
</rml>
