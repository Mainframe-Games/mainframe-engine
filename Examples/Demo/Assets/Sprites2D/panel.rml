<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="sprites2d">
    <div class="demo-panel">
        <h1>Sprites 2D</h1>
        <p class="hint">AnimatedSprite2D: flipbook animations sliced from one sprite sheet into SpriteFrames, with Godot's timing and signals.</p>
        <div class="demo-row"><span>Animation</span>
            <select data-value="animation">
                <option value="idle">Idle</option>
                <option value="run">Run</option>
                <option value="jump">Jump</option>
            </select></div>
        <div class="demo-row"><span>Speed</span><input type="range" min="0" max="3" step="0.1" data-value="speed"/></div>
        <div class="demo-row"><span>Play backwards</span><input type="checkbox" data-checked="backwards"/></div>
        <div class="demo-row"><span>Flip</span><input type="checkbox" data-checked="flip"/></div>
        <div class="demo-row"><span>Pause</span><input type="checkbox" data-checked="paused"/></div>
        <div class="demo-row"><span>Frame</span><span>{{frame}}</span></div>
        <div class="demo-row"><span>Loops</span><span>{{loops}}</span></div>
    </div>
</body>
</rml>
