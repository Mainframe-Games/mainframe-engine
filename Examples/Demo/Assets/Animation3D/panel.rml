<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="animation3d">
    <div class="demo-panel">
        <h1>Animation 3D</h1>
        <p class="hint">A skinned glTF character: 31 bones, ten clips, crossfades, events, a torch on its hand and a physical skeleton that can stay active under physics. Behind it, root motion walks and jumps a body, and keyframe tracks run a workshop: a lift, a latched door, a flickering lamp and a chime.</p>
        <div class="demo-row"><span>Clip</span>
            <select data-value="clip">
                <option value="idle">Idle</option>
                <option value="walk">Walk</option>
                <option value="run">Run</option>
                <option value="roll">Roll</option>
                <option value="swing">Swing</option>
                <option value="craft">Craft</option>
                <option value="hit">Hit</option>
                <option value="down">Down</option>
            </select></div>
        <div class="demo-row"><span>Crossfade</span><input type="range" min="0" max="0.5" step="0.05" data-value="blend"/></div>
        <div class="demo-row"><span>Speed</span><input type="range" min="0.25" max="2" step="0.05" data-value="speed"/></div>
        <div class="demo-row"><span>Last event</span><span>{{lastEvent}}</span></div>
        <div class="demo-row"><button data-if="!ragdoll" data-event-click="toggleRagdoll()">Ragdoll</button><button data-if="ragdoll" data-event-click="toggleRagdoll()">Stand up</button></div>
        <div class="demo-row"><button data-if="!active" data-event-click="toggleActive()">Active</button><button data-if="active" data-event-click="toggleActive()">Let go</button><button data-if="ragdoll" data-event-click="push()">Push</button></div>
    </div>
</body>
</rml>
