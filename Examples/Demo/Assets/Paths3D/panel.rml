<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="paths3d">
    <div class="demo-panel">
        <h1>Paths 3D</h1>
        <p class="hint">Platforms on Path3D followers carry the capsule: ride the lift, the ferry or the turntable. WASD walks, Space jumps.</p>
        <div class="demo-row"><span>Speed</span><input type="range" min="0.25" max="3" step="0.05" data-value="speed"/></div>
        <div class="demo-row"><span>Pause</span><input type="checkbox" data-checked="paused"/></div>
        <div class="demo-row"><span>Ride the camera rail</span><input type="checkbox" data-checked="rail"/></div>
        <div class="demo-row"><button data-event-click="jump()">Jump</button></div>
    </div>
</body>
</rml>
