<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="paths2d">
    <div class="demo-panel">
        <h1>Paths 2D</h1>
        <p class="hint">Path2D curves with PathFollow2D followers: cars lapping a closed track, a lift that ping-pongs, and a guard walking a patrol route.</p>
        <div class="demo-row"><span>Speed</span><input type="range" min="0.25" max="3" step="0.05" data-value="speed"/></div>
        <div class="demo-row"><span>Pause</span><input type="checkbox" data-checked="paused"/></div>
    </div>
</body>
</rml>
