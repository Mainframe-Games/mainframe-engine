<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="tiles2d">
    <div class="demo-panel">
        <h1>Tiles 2D</h1>
        <p class="hint">TileMapLayer: chunked tile layers painted from one TileSet, with per-chunk collision bodies, y-sorted rows and custom data.</p>
        <div class="demo-row"><span>Show collision</span><input type="checkbox" data-checked="collision"/></div>
        <div class="demo-row"><span>Y-sort objects</span><input type="checkbox" data-checked="ysort"/></div>
        <div class="demo-row"><span>Walk speed</span><input type="range" min="0" max="200" step="5" data-value="speed"/></div>
        <div class="demo-row"><span>Autopilot</span><input type="checkbox" data-checked="autopilot"/></div>
        <div class="demo-row"><span>Surface</span><span>{{surface}}</span></div>
        <div class="demo-row"><span>Wall cells</span><span>{{walls}}</span></div>
        <p class="hint">Click the map to add or remove a wall. WASD or the arrow keys walk.</p>
    </div>
</body>
</rml>
