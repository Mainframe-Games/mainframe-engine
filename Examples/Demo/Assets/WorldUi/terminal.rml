<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <style>
        body { width: 100%; height: 100%; font-family: LatoLatin; font-size: 26dp; color: #d8f0e0; }
        div, p, h1 { display: block; }
        #frame { position: absolute; left: 16dp; top: 16dp; right: 16dp; bottom: 16dp; border: 2dp #3fd07a; border-radius: 10dp; padding: 22dp; }
        h1 { font-size: 38dp; color: #7dffb0; margin-bottom: 18dp; }
        .status { font-size: 30dp; margin-bottom: 24dp; }
        .open { color: #7dffb0; }
        .closed { color: #ffb070; }
        /* Placed absolutely: Demo.Tests clicks its centre, panel pixel (190, 206). */
        #toggle {
            position: absolute; left: 40dp; top: 170dp; width: 300dp; height: 72dp; line-height: 72dp; text-align: center; font-size: 30dp;
            background-color: #1f6a40; border-radius: 8dp; color: #ffffff; tab-index: auto; nav: auto;
        }
        #toggle:hover, #toggle:focus-visible { background-color: #2c9a5c; }
        #toggle:active { background-color: #16502f; }
        .hint { position: absolute; left: 22dp; bottom: 18dp; font-size: 20dp; color: #8fb8a0; }
    </style>
</head>
<body data-model="terminal">
    <div id="frame">
        <h1>Gate control</h1>
        <p class="status open" data-if="open">Gate open</p>
        <p class="status closed" data-if="!open">Gate closed</p>
        <button id="toggle"><span data-if="open">Close gate</span><span data-if="!open">Open gate</span></button>
        <p class="hint" data-if="!crosshair">Tab: aim with a crosshair</p>
        <p class="hint" data-if="crosshair">Crosshair: aim and press E · Tab: mouse</p>
    </div>
</body>
</rml>
