<rml>
<head>
    <link type="text/rcss" href="/Assets/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Assets/UI/demo.rcss"/>
</head>
<body class="hud" data-model="spine">
    <div class="demo-panel">
        <h1>Spine</h1>
        <p class="hint">SpineBoy rendered through the 3D pipeline, under a 3D or a 2D camera.</p>
        <div class="demo-row"><span>2D camera</span><input type="checkbox" data-checked="mode2d"/></div>
        <div class="demo-row"><span>Animation</span>
            <select data-value="animation">
                <option value="walk">Walk</option>
                <option value="run">Run</option>
                <option value="jump">Jump</option>
                <option value="idle">Idle</option>
            </select></div>
        <div class="demo-row"><span>Shaped shadow</span><input type="checkbox" data-checked="shaped"/></div>
        <div class="demo-row"><span>Turned away</span><input type="checkbox" data-checked="turned"/></div>
        <div class="demo-row"><span>Billboard</span>
            <select data-value="billboard">
                <option value="off">Off</option>
                <option value="fixed_y">Fixed Y</option>
                <option value="enabled">Enabled</option>
            </select></div>
    </div>
</body>
</rml>
