<rml>
<head>
    <link type="text/rcss" href="/Content/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Content/UI/demo.rcss"/>
</head>
<body class="hud" data-model="physics2d">
    <div class="demo-panel">
        <h1>Physics 2D</h1>
        <p class="hint">Box2D bodies through a funnel and pegboard. Click to spawn a body.</p>
        <div class="demo-row"><span>Bodies</span><span>{{count}}</span></div>
        <div class="demo-row"><span>Collision shapes</span><input type="checkbox" data-checked="shapes"/></div>
        <div class="demo-row"><button data-event-click="reset()">Reset</button></div>
    </div>
</body>
</rml>
