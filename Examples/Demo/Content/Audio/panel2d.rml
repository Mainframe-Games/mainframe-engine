<rml>
<head>
    <link type="text/rcss" href="/Content/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="/Content/UI/demo.rcss"/>
</head>
<body class="hud" data-model="audio2d">
    <div class="demo-panel">
        <h1>Audio 2D</h1>
        <p class="hint">The emitter sweeps past the camera (the listener). Click anywhere to play a blip there.</p>
        <div class="demo-row"><span>Master</span><input type="range" min="-60" max="6" step="1" data-value="master"/></div>
        <div class="demo-row"><span>SFX</span><input type="range" min="-60" max="6" step="1" data-value="sfx"/></div>
        <div class="demo-row"><span>Music</span><input type="range" min="-60" max="6" step="1" data-value="music"/></div>
        <div class="demo-row"><span>Panning</span><input type="range" min="0" max="1" step="0.05" data-value="panning"/></div>
        <div class="demo-row"><span>Max distance</span><input type="range" min="100" max="2000" step="50" data-value="distance"/></div>
    </div>
</body>
</rml>
