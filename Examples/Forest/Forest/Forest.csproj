<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Forest's code: the first-person controller, world helpers and dev tools. The editor loads this assembly to edit them. -->

  <ItemGroup>
    <ProjectReference Include="$(MainframeEnginePath)/MainframeEngine/MainframeEngine.csproj" />
    <!-- Registers [Export]/[Signal]/[Replicated] members so scenes can save and load this assembly's types. -->
    <ProjectReference Include="$(MainframeEnginePath)/MainframeEngine.Generators/MainframeEngine.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Debug builds record the project's Content folder so a running game hot-reloads its .rml/.rcss from the sources. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MainframeContentSource</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../Content'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
