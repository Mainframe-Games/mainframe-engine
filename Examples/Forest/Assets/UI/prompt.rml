<rml>
<head>
    <style>
        /* A HUD: clicks pass through to the game (as widgets.rcss's body.hud). */
        body { font-family: LatoLatin; width: 100%; height: 100%; pointer-events: none; }
        div { display: block; }
        #prompt {
            position: absolute;
            top: 58%;
            left: 0;
            right: 0;
            text-align: center;
            pointer-events: none;
        }
        #prompt .pill {
            display: inline-block;
            padding: 6dp 14dp 7dp 8dp;
            border-radius: 18dp;
            background-color: rgba(0, 0, 0, 120);
            color: #f2eee4;
            font-size: 18dp;
            white-space: nowrap;
        }
        #prompt .key {
            display: inline-block;
            min-width: 14dp;
            margin-right: 8dp;
            padding: 1dp 6dp;
            border-radius: 4dp;
            border: 1dp #f2eee4;
            font-size: 15dp;
            text-align: center;
        }
    </style>
</head>
<body class="hud" data-model="prompt">
    <div id="prompt" data-if="shown">
        <div class="pill"><span class="key">{{key}}</span>{{verb}}</div>
    </div>
</body>
</rml>
