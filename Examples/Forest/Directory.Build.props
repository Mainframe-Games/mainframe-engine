<Project>
  <!-- Settings shared by Forest, Forest.Desktop and Forest.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The engine checkout this game builds against (the folder holding MainframeEngine.slnx). -->
    <MainframeEnginePath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '../..'))))</MainframeEnginePath>
  </PropertyGroup>

  <!-- Demo builds: "isDemo" in project.mfproj (or -p:MainframeDemo=true) compiles the game with DEMO defined (#if DEMO). -->
  <Import Project="$(MainframeEnginePath)/build/MainframeGame.props" />
</Project>
