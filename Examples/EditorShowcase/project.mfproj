{
  "format": 1,
  "name": "EditorShowcase",
  "engineVersion": "1.0.0",
  "mainScene": "Content/Scenes/Main.mscene",
  "assemblies": [
    "EditorShowcase"
  ],
  "window": {
    "width": 1280,
    "height": 720,
    "vsync": true
  },
  "physics": {
    "ticksPerSecond": 60,
    "maxStepsPerFrame": 5,
    "3d": {
      "gravity": [
        0,
        -9.81,
        0
      ]
    }
  },
  "input": {
    "spin_faster": {
      "bindings": [
        "key:Up",
        "pad:DPadUp",
        "axis:RightTrigger+"
      ]
    },
    "spin_slower": {
      "bindings": [
        "key:Down",
        "pad:DPadDown",
        "axis:LeftTrigger+"
      ]
    }
  },
  "audio": {
    "busLayout": "Content/Settings/AudioBusLayout.mres"
  },
  "localization": {
    "sourceLocale": "en",
    "fallbacks": [],
    "directory": "Content/locale"
  },
  "rendering": {
    "shadows": "High"
  }
}
