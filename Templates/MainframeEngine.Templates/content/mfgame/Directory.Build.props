<Project>
  <!-- Settings shared by MyGame and MyGame.Desktop. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      The game states its package versions on its own PackageReferences: a Directory.Packages.props further up (a game
      inside a repository with central package management) does not apply, just as this file stops the outer
      Directory.Build.props.
    -->
    <ImportDirectoryPackagesProps>false</ImportDirectoryPackagesProps>
  </PropertyGroup>

  <PropertyGroup>
<!--#if (UsePackage) -->
    <!--
      The MainframeEngine package version (one version for the editor and the engine). The package also brings the
      source generator, the natives, the engine content and the build integration (DEMO from "isDemo" in project.mfproj,
      .po to .mo, the macOS app bundle) that a checkout game imports from the engine's build/ folder.
    -->
    <MainframeEngineVersion>MAINFRAME_ENGINE_VERSION</MainframeEngineVersion>
<!--#else -->
    <!-- The engine checkout this game builds against (the folder holding MainframeEngine.slnx). -->
    <MainframeEnginePath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'MAINFRAME_ENGINE_PATH'))))</MainframeEnginePath>
<!--#endif -->
  </PropertyGroup>

<!--#if (!UsePackage) -->
  <!-- Demo builds: "isDemo" in project.mfproj (or -p:MainframeDemo=true) compiles the game with DEMO defined (#if DEMO). -->
  <Import Project="$(MainframeEnginePath)/build/MainframeGame.props" />
<!--#endif -->
</Project>
