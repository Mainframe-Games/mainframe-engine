<Project Sdk="Microsoft.NET.Sdk">

  <!-- The executable: runs the project with GameHost (project.mfproj next to the app). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MyGame/MyGame.csproj" />
  </ItemGroup>

  <!-- The project file and the game's content are copied next to the app. -->
  <ItemGroup>
    <None Include="../project.mfproj" Link="project.mfproj" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Assets/**" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Localization: Assets/locale/<locale>/LC_MESSAGES/messages.po catalogs are compiled to .mo at build time (no gettext
    needed) and copied to Assets/locale/ next to the app, where Tr loads them. Add a language with the engine's
    mf-l10n tool (extract, update, compile; docs/design/localization.md).
  -->
  <PropertyGroup>
    <LocaleContentRoot>../Assets</LocaleContentRoot>
  </PropertyGroup>
<!--#if (!UsePackage) -->
  <Import Project="$(MainframeEnginePath)/build/Localization.targets" />
<!--#endif -->

</Project>
