{
  "format": 3,
  "name": "MyGame",
  "engineVersion": "MAINFRAME_ENGINE_VERSION",
  "mainScene": "Content/Scenes/Main.mscene",
  "assemblies": [
    "MyGame"
  ],
  "window": {
    "width": 1280,
    "height": 720,
    "vsync": true,
    "icon": "Content/icon.png"
  },
  "physics": {
    "ticksPerSecond": 60,
    "maxStepsPerFrame": 5,
    "3d": {
      "gravity": [
        0,
        -9.81,
        0
      ]
    }
  },
  "input": {
    "spin_faster": {
      "bindings": [
        "key:Up",
        "pad:DPadUp",
        "axis:RightTrigger+"
      ]
    },
    "spin_slower": {
      "bindings": [
        "key:Down",
        "pad:DPadDown",
        "axis:LeftTrigger+"
      ]
    }
  },
  "audio": {
    "busLayout": "Content/Settings/AudioBusLayout.mres"
  },
  "localization": {
    "sourceLocale": "en",
    "fallbacks": [],
    "directory": "Content/locale"
  },
  "rendering": {
    "shadows": "High"
  },
  "ui": {
    "scaleMode": "ScaleWithScreenSize",
    "referenceResolution": [
      1920,
      1080
    ],
    "matchWidthOrHeight": 1
  }
}
