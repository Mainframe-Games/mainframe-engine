<Project Sdk="Microsoft.NET.Sdk">

  <!-- The game's code: node and resource types used by its scenes. The editor loads this assembly to edit them. -->

<!--#if (UsePackage) -->
  <ItemGroup>
    <!-- Future: the package carries the engine, its natives and content, and the source generator. -->
    <PackageReference Include="MainframeEngine" Version="$(MainframeEngineVersion)" />
  </ItemGroup>
<!--#else -->
  <ItemGroup>
    <ProjectReference Include="$(MainframeEnginePath)/MainframeEngine/MainframeEngine.csproj" />
    <!-- Registers [Export]/[Signal]/[Replicated] members so scenes can save and load this assembly's types. -->
    <ProjectReference Include="$(MainframeEnginePath)/MainframeEngine.Generators/MainframeEngine.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
<!--#endif -->

</Project>
