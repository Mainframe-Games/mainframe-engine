---
// The editor's video mode (docs/design/video-editor.md) and the gameplay recording it edits (docs/design/recording.md),
// beside its screenshot. Laid out like the audio tools (Daw.astro) and styled by the same mf-daw classes.
import TablerIcon from './TablerIcon.astro';

const base = import.meta.env.BASE_URL;
const img = (p: string) => `${base}images/${p}`;
const alt =
  'Video mode: a narrated Physics 2D recording on a 9:16 timeline with a pause cut out, the media pool, the Source and Timeline viewers, the Inspector and the cut editor';
const points = [
  { icon: 'camera', text: 'Record any game to MP4 with F10 in the editor or --record, through your own ffmpeg' },
  { icon: 'file-import', text: 'A media pool in the project: import from a picker or drag files in from Finder' },
  { icon: 'timeline', text: 'Video and audio tracks, Source and Timeline viewers, Premiere’s keys' },
  { icon: 'scissors', text: 'Razor, add edit, ripple trim and delete, insert and overwrite, link and unlink' },
  { icon: 'device-mobile', text: 'Reframe landscape gameplay for 9:16: fit, fill, scale, position, crop' },
  { icon: 'file-export', text: 'Export presets for TikTok, Reels and Shorts, YouTube and Steam, X and Discord, GIF loops' },
];
---

<section class="mf-section mf-daw mf-video not-content" aria-labelledby="video-title">
  <header class="mf-section__head" data-reveal>
    <p class="mf-kicker">Video mode</p>
    <h2 id="video-title">Socials and trailers without leaving the editor</h2>
    <p>
      Record a play session, then flip the Game|Video toggle: the editor becomes a multi-track timeline editor, laid
      out like Resolve’s Edit page, working on the project’s own recordings and media.
    </p>
  </header>
  <div class="mf-daw__row">
    <figure class="mf-window" data-reveal>
      <div class="mf-window__bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>Video mode</p>
      </div>
      <button class="mf-shot" type="button" data-full={img('editor-video.png')} data-caption={alt}>
        <img src={img('editor-video.png')} width="1600" height="960" alt={alt} loading="lazy" decoding="async" />
      </button>
    </figure>
    <div class="mf-daw__copy" data-reveal style="--i: 1">
      <p class="mf-kicker">Record, edit, export</p>
      <h3>From a play session to a vertical short</h3>
      <ul>
        {
          points.map((p) => (
            <li>
              <TablerIcon name={p.icon} />
              <span>{p.text}</span>
            </li>
          ))
        }
      </ul>
      <a class="mf-daw__more" href={`${base}docs/design/video-editor/`}>How it works →</a>
    </div>
  </div>
</section>
