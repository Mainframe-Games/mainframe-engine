---
// The site's lightbox (Head.astro puts it on every page): a click on a landing screenshot (.mf-shot[data-full]), a docs
// image or a Mermaid diagram opens it over the whole window; arrows (or ← →) step through the page's others, Esc or a
// click closes it. Styles in styles/theme.css.
---

<script>
  const selector = '.mf-shot[data-full], .sl-markdown-content img, pre.mermaid[data-processed] > svg';
  // Images inside links keep the link, and the landing's (.not-content) are inside their .mf-shot; a diagram is zoomable
  // once Mermaid has drawn it.
  const zoomable = (el: Element) => !(el instanceof HTMLImageElement && el.closest('a, .not-content'));
  const items = () => [...document.querySelectorAll(selector)].filter(zoomable);

  const box = document.createElement('dialog');
  box.className = 'mf-lightbox';
  box.setAttribute('aria-label', 'Enlarged view');
  box.innerHTML = `
    <div class="mf-lightbox__stage"></div>
    <p class="mf-lightbox__caption"></p>
    <button class="mf-lightbox__button mf-lightbox__close" type="button" aria-label="Close">×</button>
    <button class="mf-lightbox__button mf-lightbox__prev" type="button" aria-label="Previous">‹</button>
    <button class="mf-lightbox__button mf-lightbox__next" type="button" aria-label="Next">›</button>`;
  const stage = box.querySelector<HTMLElement>('.mf-lightbox__stage')!;
  const caption = box.querySelector<HTMLElement>('.mf-lightbox__caption')!;
  let list: Element[] = [];
  let index = 0;

  function show(i: number) {
    index = (i + list.length) % list.length;
    const item = list[index];
    let text = '';
    if (item instanceof SVGElement) {
      // Mermaid sizes its SVG with an inline max-width: the copy fills the stage instead.
      const svg = item.cloneNode(true) as SVGElement;
      svg.removeAttribute('style');
      svg.setAttribute('width', '100%');
      svg.setAttribute('height', '100%');
      const [, , w, h] = (svg.getAttribute('viewBox') ?? '').split(/[\s,]+/).map(Number);
      if (w > 0 && h > 0) svg.style.setProperty('--ratio', String(w / h));
      stage.replaceChildren(svg);
    } else {
      const img = document.createElement('img');
      if (item instanceof HTMLImageElement) {
        img.src = item.currentSrc || item.src;
        text = item.alt;
      } else {
        const shot = item as HTMLElement;
        img.src = shot.dataset.full!;
        text = shot.dataset.caption ?? '';
      }
      img.alt = text;
      const fit = () => img.style.setProperty('--ratio', String(img.naturalWidth / img.naturalHeight));
      img.addEventListener('load', fit, { once: true });
      stage.replaceChildren(img);
    }
    caption.textContent = text;
    caption.hidden = !text;
    box.classList.toggle('is-single', list.length < 2);
  }

  function open(item: Element) {
    list = items();
    if (!box.isConnected) document.body.append(box);
    show(Math.max(0, list.indexOf(item)));
    box.showModal();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (box.contains(target)) return;
    // A click on a diagram's frame, around the SVG, opens it too.
    const item = target.closest(selector) ?? target.closest('pre.mermaid[data-processed]')?.querySelector('svg');
    if (item && zoomable(item)) open(item);
  });
  // Docs images and diagrams aren't buttons: Enter on a focused one opens it too (Head.astro and below make them focusable).
  document.addEventListener('keydown', (e) => {
    const el = e.target as Element;
    if (e.key !== 'Enter' || box.open || !el.matches?.('.sl-markdown-content img, pre.mermaid')) return;
    const item = el.matches('pre.mermaid') ? el.querySelector('svg') : el;
    if (item && zoomable(item)) open(item);
  });
  document.querySelectorAll('.sl-markdown-content img').forEach((img) => {
    if (zoomable(img)) img.setAttribute('tabindex', '0');
  });

  box.addEventListener('click', (e) => {
    const button = (e.target as Element).closest('button');
    if (button?.classList.contains('mf-lightbox__prev')) show(index - 1);
    else if (button?.classList.contains('mf-lightbox__next')) show(index + 1);
    else box.close();
  });
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
  });
  box.addEventListener('close', () => stage.replaceChildren());
</script>
