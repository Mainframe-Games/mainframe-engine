<rml>
<head>
    <title>Sandbox HUD</title>
    <link type="text/rcss" href="/Content/UI/widgets/widgets.rcss"/>
    <link type="text/rcss" href="hud.rcss"/>
</head>
<!--
  Text is translated through the Sandbox's catalogs (Content/locale, `just l10n-extract`); the stat abbreviations
  opt out with class="no-tr". Data-bound values ({{ ... }}) are not translated.
-->
<body class="hud" data-model="sandbox">
    <div id="stats" class="panel">
        <span class="stat"><span class="label no-tr">FPS</span> {{ fps }}</span>
        <span class="stat"><span class="label no-tr">ms </span> {{ ms | format(2) }}</span>
        <span class="stat"><span class="label no-tr">frm</span> {{ frame }}</span>
        <span class="stat"><span class="label no-tr">ui </span> {{ uiDraws }} draws</span>
    </div>

    <div id="welcome" data-if="welcomeTitle != ''">
        <div class="title">{{ welcomeTitle }}</div>
        <div class="hint">{{ welcomeHint }}</div>
    </div>

    <div id="settings" class="panel">
        <div class="panel-title">Scene</div>
        <div class="row">
            <label class="caption">Exposure</label>
            <input id="exposure" type="range" min="0.25" max="4" step="0.05" data-value="exposure"/>
            <span class="value mono">{{ exposure | format(2) }}</span>
        </div>
        <div class="row">
            <label class="caption">Spin speed</label>
            <input id="spin" type="range" min="0" max="180" step="1" data-value="spin"/>
            <span class="value mono">{{ spin }}</span>
        </div>
        <div class="row">
            <label class="caption">Max FPS</label>
            <select id="maxfps" data-value="maxFps">
                <option value="0">Unlimited</option>
                <option value="30">30</option>
                <option value="60">60</option>
                <option value="120">120</option>
                <option value="144">144</option>
                <option value="240">240</option>
            </select>
        </div>
        <div class="row">
            <label class="caption">Language</label>
            <select id="language" data-value="locale">
                <option data-for="l : locales" data-attr-value="l.id">{{ l.name }}</option>
            </select>
        </div>
        <div class="toggles">
            <span class="toggle"><input id="sun" type="checkbox" data-checked="sun"/><label>Sun</label></span>
            <span class="toggle"><input id="lamps" type="checkbox" data-checked="lamps"/><label>Coloured lights</label></span>
            <span class="toggle"><input id="vsync" type="checkbox" data-checked="vsync"/><label>VSync</label></span>
            <span class="toggle"><input id="shapes" type="checkbox" data-checked="shapes"/><label>Colliders</label></span>
        </div>
        <div class="buttons">
            <button id="widgets" data-event-click="toggleWidgets">Widgets</button>
            <button id="overlay" data-event-click="toggleOverlay">Dev overlay</button>
            <button id="credits" data-event-click="toggleCredits">Credits</button>
            <button id="quit" class="primary">Quit</button>
        </div>
    </div>

    <div id="hints">Right-drag look · WASD move · Q/E down/up · F8 UI debugger · F12 dev overlay · Esc quit</div>
</body>
</rml>
