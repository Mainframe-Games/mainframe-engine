<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>Content\Branding\mg_300_circle.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MainframeEngine\MainframeEngine.csproj" />
      <!-- Registers the Sandbox's own node types (FlyCamera, SpinningBox) for Content/Scenes/Sandbox.mscene. -->
      <ProjectReference Include="..\MainframeEngine.Generators\MainframeEngine.Generators.csproj"
                        OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- Copy everything in content folder to build destination -->
    <ItemGroup>
        <None Update="Content\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>


    <!-- Debug builds record this project's Content folder so the UI can load (and hot-reload) from the sources. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>MainframeContentSource</_Parameter1>
        <_Parameter2>$(MSBuildProjectDirectory)/Content</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

    <!-- M9: Content/locale/*/LC_MESSAGES/messages.po -> .mo in the output (mf-l10n; committed .mo fallback) -->
    <Import Project="..\build\Localization.targets" />

</Project>
