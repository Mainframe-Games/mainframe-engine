<Project>
  <!--
    Build-time shader pipeline for MainframeEngine (docs/design/shaders.md):

    1. GenerateShaderLimits: Content/Shaders/limits.json → Src/Rendering/Generated/ShaderLimits.g.cs (C#) and
       Content/Shaders/include/limits.glsl (GLSL), so the two languages can never disagree. Files are rewritten
       only when their content changes; both are committed so shader tools work without a build.
    2. CompileShaders: every Content/Shaders/**/*.vk.{vert,frag,comp} → $(IntermediateOutputPath)Shaders/**.spv
       with glslc, target environment vulkan1.2 and Content/Shaders/include on the include path (the flags
       build/shaders.sh uses), incrementally
       (any source, include or limits.json newer than the outputs). glslc errors show up as build errors.
    3. The compiled .spv files are copied to Content/Shaders/ in the output (and every referencing app). When glslc
       is missing, the build warns and copies the committed .spv files instead (`just shaders` keeps them current;
       `just shaders-check` and CI verify them against shaders.lock). -p:CompileShaders=false forces that fallback.

    glslc is looked up as $(Glslc), then $(VULKAN_SDK)/bin/glslc, then on PATH.
  -->

  <PropertyGroup>
    <CompileShaders Condition="'$(CompileShaders)' == ''">true</CompileShaders>
    <ShaderSourceDir>$(MSBuildProjectDirectory)/Content/Shaders/</ShaderSourceDir>
    <ShaderIncludeDir>$(ShaderSourceDir)include</ShaderIncludeDir>
    <ShaderLimitsJson>$(ShaderSourceDir)limits.json</ShaderLimitsJson>
    <ShaderLimitsGlsl>$(ShaderIncludeDir)/limits.glsl</ShaderLimitsGlsl>
    <ShaderLimitsCSharp>$(MSBuildProjectDirectory)/Src/Rendering/Generated/ShaderLimits.g.cs</ShaderLimitsCSharp>
    <!-- BaseIntermediateOutputPath (obj/) is known here; IntermediateOutputPath is only set by the SDK targets. -->
    <ShaderOutputDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(BaseIntermediateOutputPath), $(Configuration), Shaders))))</ShaderOutputDir>
    <ShaderTargetEnv>vulkan1.2</ShaderTargetEnv>
  </PropertyGroup>

  <ItemGroup>
    <ShaderSource Include="Content/Shaders/**/*.vk.vert;Content/Shaders/**/*.vk.frag;Content/Shaders/**/*.vk.comp">
      <SubDir>%(RecursiveDir)</SubDir>
    </ShaderSource>
    <ShaderInclude Include="Content/Shaders/include/*.glsl" />
    <!-- Shader sources, includes, the lock and the committed .spv are build inputs, not runtime content. -->
    <None Update="Content/Shaders/**" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <UsingTask TaskName="GenerateShaderLimits" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <LimitsFile ParameterType="System.String" Required="true" />
      <CSharpFile ParameterType="System.String" Required="true" />
      <GlslFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var json = File.ReadAllText(LimitsFile);
        var entry = new Regex(
            "\\{\\s*\"glsl\"\\s*:\\s*\"(?<glsl>[A-Z][A-Z0-9_]*)\"\\s*,\\s*\"csharp\"\\s*:\\s*\"(?<cs>[A-Z][A-Za-z0-9]*)\"\\s*,\\s*" +
            "\"value\"\\s*:\\s*(?<value>-?[0-9]+)\\s*,\\s*\"summary\"\\s*:\\s*\"(?<summary>[^\"]*)\"\\s*\\}");
        var matches = entry.Matches(json);
        var declared = Regex.Matches(json, "\"glsl\"\\s*:").Count;
        if (matches.Count == 0 || matches.Count != declared)
        {
            Log.LogError("{0}: expected {1} limits as {{ \"glsl\", \"csharp\", \"value\", \"summary\" }} objects, parsed {2}.",
                LimitsFile, declared, matches.Count);
            return false;
        }

        var cs = new StringBuilder();
        cs.Append("// <auto-generated>\n// Generated from Content/Shaders/limits.json by build/Shaders.targets. Do not edit.\n// </auto-generated>\n\n");
        cs.Append("namespace MainframeEngine;\n\n");
        cs.Append("/// <summary>Limits shared with the shaders (<c>include/limits.glsl</c>); generated from <c>limits.json</c>.</summary>\n");
        cs.Append("internal static class ShaderLimits\n{\n");
        var glsl = new StringBuilder();
        glsl.Append("// Generated from Content/Shaders/limits.json by build/Shaders.targets. Do not edit.\n");
        glsl.Append("#ifndef MF_LIMITS_GLSL\n#define MF_LIMITS_GLSL\n\n");
        var first = true;
        foreach (Match m in matches)
        {
            var summary = m.Groups["summary"].Value.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");
            if (!first) cs.Append('\n');
            first = false;
            cs.Append("    /// <summary>" + summary + "</summary>\n");
            cs.Append("    public const int " + m.Groups["cs"].Value + " = " + m.Groups["value"].Value + ";\n");
            glsl.Append("#define " + m.Groups["glsl"].Value + " " + m.Groups["value"].Value + " // " + m.Groups["summary"].Value + "\n");
        }

        cs.Append("}\n");
        glsl.Append("\n#endif\n");

        foreach (var (path, text) in new[] { (CSharpFile, cs.ToString()), (GlslFile, glsl.ToString()) })
        {
            if (File.Exists(path) && File.ReadAllText(path) == text)
                continue;
            Directory.CreateDirectory(Path.GetDirectoryName(path));
            File.WriteAllText(path, text);
            Log.LogMessage(MessageImportance.Normal, "Generated {0}", path);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Before compiling C# (the constants) and before compiling shaders (the header). -->
  <Target Name="GenerateShaderLimits" BeforeTargets="BeforeBuild;CoreCompile;CompileShaders"
          Inputs="$(ShaderLimitsJson);$(MSBuildThisFileFullPath)" Outputs="$(ShaderLimitsCSharp);$(ShaderLimitsGlsl)">
    <GenerateShaderLimits LimitsFile="$(ShaderLimitsJson)" CSharpFile="$(ShaderLimitsCSharp)" GlslFile="$(ShaderLimitsGlsl)" />
    <!-- Touch so the incremental check sees fresh outputs even when the content was unchanged. -->
    <Touch Files="$(ShaderLimitsCSharp);$(ShaderLimitsGlsl)" />
  </Target>

  <Target Name="FindGlslc" Condition="'$(CompileShaders)' == 'true'">
    <PropertyGroup>
      <_GlslcExe Condition="'$(OS)' == 'Windows_NT'">glslc.exe</_GlslcExe>
      <_GlslcExe Condition="'$(OS)' != 'Windows_NT'">glslc</_GlslcExe>
      <GlslcPath Condition="'$(Glslc)' != ''">$(Glslc)</GlslcPath>
      <GlslcPath Condition="'$(GlslcPath)' == '' and '$(VULKAN_SDK)' != '' and Exists('$(VULKAN_SDK)/bin/$(_GlslcExe)')">$(VULKAN_SDK)/bin/$(_GlslcExe)</GlslcPath>
      <GlslcPath Condition="'$(GlslcPath)' == ''">$(_GlslcExe)</GlslcPath>
    </PropertyGroup>
    <Exec Command="&quot;$(GlslcPath)&quot; --version" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_GlslcExitCode" />
    </Exec>
    <PropertyGroup>
      <GlslcAvailable Condition="'$(_GlslcExitCode)' == '0'">true</GlslcAvailable>
      <GlslcAvailable Condition="'$(_GlslcExitCode)' != '0'">false</GlslcAvailable>
    </PropertyGroup>
    <Warning Condition="'$(GlslcAvailable)' != 'true'" Code="MFSHADER001"
             Text="glslc not found (install the Vulkan SDK or set -p:Glslc=path); using the committed .spv files. Shader edits will not take effect until 'just shaders' is run." />
  </Target>

  <Target Name="CompileShaders" DependsOnTargets="GenerateShaderLimits;FindGlslc"
          Condition="'$(CompileShaders)' == 'true'"
          Inputs="@(ShaderSource);@(ShaderInclude);$(ShaderLimitsJson);$(MSBuildThisFileFullPath)"
          Outputs="@(ShaderSource->'$(ShaderOutputDir)%(SubDir)%(Filename)%(Extension).spv')">
    <MakeDir Condition="'$(GlslcAvailable)' == 'true'" Directories="@(ShaderSource->'$(ShaderOutputDir)%(SubDir)')" />
    <Exec Condition="'$(GlslcAvailable)' == 'true'"
          Command="&quot;$(GlslcPath)&quot; --target-env=$(ShaderTargetEnv) -I &quot;$(ShaderIncludeDir)&quot; &quot;%(ShaderSource.FullPath)&quot; -o &quot;$(ShaderOutputDir)%(ShaderSource.SubDir)%(ShaderSource.Filename)%(ShaderSource.Extension).spv&quot;"
          CustomErrorRegularExpression=": error"
          CustomWarningRegularExpression=": warning" />
  </Target>

  <!--
    Adds the shaders to the output as Content/Shaders/<dir>/<name>.spv: compiled ones when glslc ran, the committed
    ones otherwise. Runs before AssignTargetPaths so referencing projects (which ask for this project's
    copy-to-output items) get them too.
  -->
  <Target Name="IncludeShadersInOutput" BeforeTargets="AssignTargetPaths" DependsOnTargets="CompileShaders;FindGlslc">
    <ItemGroup Condition="'$(CompileShaders)' == 'true' and '$(GlslcAvailable)' == 'true'">
      <_ShaderBinary Include="@(ShaderSource->'$(ShaderOutputDir)%(SubDir)%(Filename)%(Extension).spv')" />
    </ItemGroup>
    <ItemGroup Condition="'$(CompileShaders)' != 'true' or '$(GlslcAvailable)' != 'true'">
      <_ShaderBinary Include="@(ShaderSource->'%(Identity).spv')" />
    </ItemGroup>
    <ItemGroup>
      <!-- Filename is "X.vk.frag" and Extension ".spv" for both sources of binaries. -->
      <None Include="@(_ShaderBinary)" Link="Content/Shaders/%(_ShaderBinary.SubDir)%(_ShaderBinary.Filename)%(_ShaderBinary.Extension)"
            CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>
</Project>
