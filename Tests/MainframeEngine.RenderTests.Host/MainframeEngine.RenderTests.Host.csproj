<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs one render-test scene in its own process and reports the results as JSON + PNGs.
    Render tests launch it out of process because windowing (SDL/Cocoa) must own the process main
    thread on macOS, and so a driver crash fails one test instead of the whole test run.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
  </ItemGroup>

  <!-- Shared test content (Tests/Content): glTF test model, SpineBoy, ambience, the logo image and the compiled catalogs. -->
  <ItemGroup>
    <None Include="..\Content\Models\**" LinkBase="Content\Models" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Content\Audio\**" LinkBase="Content\Audio" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Content\Branding\logo.png" Link="Content\UI\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Content\locale\**\*.mo" LinkBase="Content\locale" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- UI documents for the game-UI scenes. -->
  <ItemGroup>
    <None Update="Content\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
