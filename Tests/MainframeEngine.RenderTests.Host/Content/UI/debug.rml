<rml>
<head>
    <style>
        body { font-family: LatoLatin; font-size: 12dp; color: #ffffff; width: 100%; height: 100%; background-color: #304050; }
        div { display: block; }
        .cell { position: absolute; width: 90dp; height: 60dp; top: 20dp; }
        #opacity { left: 20dp; background-color: #ff8000; filter: opacity(0.5); }
        #plain { left: 140dp; background-color: #ff8000; }
        #clip { left: 260dp; border-radius: 20dp; overflow: hidden; background-color: #204060; }
        #clip div { position: absolute; left: 0dp; top: 20dp; width: 100%; height: 20dp; background-color: #e0c040; }
    </style>
</head>
<body>
    <div class="cell" id="opacity"></div>
    <div class="cell" id="plain"></div>
    <div class="cell" id="clip"><div></div></div>
</body>
</rml>
