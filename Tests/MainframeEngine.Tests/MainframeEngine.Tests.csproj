<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast unit tests for pure logic: no window, no GPU. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- Run through VSTest (Microsoft.NET.Test.Sdk + xunit.runner.visualstudio) so coverlet.collector works. -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
    <!-- Registers the test node/resource types ([Export], [Signal]) like any game assembly. -->
    <ProjectReference Include="..\..\MainframeEngine.Generators\MainframeEngine.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Generator tests drive the generator with CSharpGeneratorDriver, so they also need its assembly and
    Roslyn as ordinary (test-only) references. Aliased so the generator's internals never clash with ours.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine.Generators\MainframeEngine.Generators.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" Aliases="generators" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- M9: mf-l10n (in-process CLI, .po/.mo, extractors) and its fixture project (data, never compiled here). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Tools\MainframeEngine.L10n\MainframeEngine.L10n.csproj" />
    <Compile Remove="Localization\Fixtures\**" />
    <None Include="Localization\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Sandbox scene is parsed and round-tripped by the serialization tests. -->
  <ItemGroup>
    <None Include="..\..\MainframeEngine.Sandbox\Content\Scenes\Sandbox.mscene"
          Link="Content\Scenes\Sandbox.mscene" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Audio decoder/server tests: tiny generated tones (WAV, OGG, MP3, FLAC; stored in Git LFS). -->
  <ItemGroup>
    <None Update="Content\Audio\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The Sandbox scene's ambience, so the scene can be played in a test tree. -->
    <None Include="..\..\MainframeEngine.Sandbox\Content\Audio\ambient_hum.ogg"
          Link="Content\Audio\ambient_hum.ogg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The glTF test model (generated by TestAssets/TestModel.cs; the committed copy lives with the Sandbox). -->
  <ItemGroup>
    <None Include="..\..\MainframeEngine.Sandbox\Content\Models\TestModel\**"
          LinkBase="Content\Models\TestModel"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- SpineNode tests load SpineBoy (shared with the Sandbox rather than duplicated). -->
  <ItemGroup>
    <None Include="..\..\MainframeEngine.Sandbox\Content\Models\Spine\SpineBoy\**"
          LinkBase="Content\Models\Spine\SpineBoy"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
