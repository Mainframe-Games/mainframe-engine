<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast unit tests for pure logic: no window, no GPU. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <!-- A few tests read native buffers (SDL surfaces) directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Run through VSTest (Microsoft.NET.Test.Sdk + xunit.runner.visualstudio) so coverlet.collector works. -->
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
    <!-- Registers the test node/resource types ([Export], [Signal]) like any game assembly. -->
    <ProjectReference Include="..\..\MainframeEngine.Generators\MainframeEngine.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Generator tests drive the generator with CSharpGeneratorDriver, so they also need its assembly and
    Roslyn as ordinary (test-only) references. Aliased so the generator's internals never clash with ours.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine.Generators\MainframeEngine.Generators.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" Aliases="generators" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- G15: the crashing fixture game the out-of-process crash tests run (Crash/CrashProcessTests.cs). -->
  <ItemGroup>
    <ProjectReference Include="..\MainframeEngine.CrashTests.Fixture\MainframeEngine.CrashTests.Fixture.csproj" />
    <ProjectReference Include="..\..\Tools\MainframeEngine.Symbolicate\MainframeEngine.Symbolicate.csproj" />
  </ItemGroup>

  <!-- M9: mf-l10n (in-process CLI, .po/.mo, extractors) and its fixture project (data, never compiled here). -->
  <ItemGroup>
    <ProjectReference Include="..\..\Tools\MainframeEngine.L10n\MainframeEngine.L10n.csproj" />
    <Compile Remove="Localization\Fixtures\**" />
    <None Include="Localization\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared test content (Tests/Content: the showcase fixture scene, glTF test model, SpineBoy, sky, ambience, catalogs). -->
  <ItemGroup>
    <None Include="..\Assets\**" LinkBase="Assets" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The recording sidecar contract fixture, byte-identical to Cutback's copy (Recording/CaptureSidecarWriterTests). -->
  <ItemGroup>
    <None Include="Recording\Fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Recording\Fixtures" />
  </ItemGroup>
  <!-- Godot's BitMap and Geometry2D results for the same inputs (Imaging/Fixtures/godot-geometry-reference.gd). -->
  <ItemGroup>
    <None Include="Imaging\Fixtures\**" CopyToOutputDirectory="PreserveNewest" LinkBase="Imaging\Fixtures" />
  </ItemGroup>

  <!-- Audio decoder/server tests: tiny generated tones (WAV, OGG, MP3, FLAC; stored in Git LFS). -->
  <ItemGroup>
    <None Update="Assets\Audio\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
