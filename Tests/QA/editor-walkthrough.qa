# Editor QA walkthrough (just qa-editor): drives the real editor through the UI input path and captures each step.
# Window 1600x960 points (hidden). Review the PNGs in artifacts/qa-editor after a run.
wait 40
capture 01-opened
# Tooltips: hovering an icon-only button shows its name, shortcut and what it does after 0.5 s.
move #tool-translate
wait 60
capture 01b-tooltip
move 800 500
wait 2
# Select a mesh by clicking it in the 3D view, then frame it.
select Ring/Column
key F
wait 8
capture 02-selected-framed
# Move it up with the gizmo, rotate it, then undo the rotation.
gizmo-drag y 0 -60
wait 3
capture 03-moved
key E
gizmo-drag y 60 0
wait 3
capture 04-rotated
key Z cmd
wait 3
state
capture 05-undone
# Menus, the undo history and the add-node dialog.
click #menu-edit
wait 3
capture 06-edit-menu
cancel
command edit.history
wait 3
capture 07-history
cancel
key A cmd
wait 3
type Spot
wait 3
capture 08-add-node
accept
wait 3
capture 09-added
# Duplicate, rename, delete through shortcuts and dialogs.
key D cmd
wait 3
command edit.rename
wait 2
capture 10-rename
cancel
key Delete
wait 3
capture 11-deleted
# Dialog titles: icon and text side by side (New Project, Connect Signal from the Signals tab's first connect button).
command project.new
wait 3
capture 11b-new-project
cancel
select Ring/Box
click #tab-signals
wait 3
click 1582 105
wait 3
capture 11c-connect-signal
cancel
click #tab-properties
wait 2
# File dialogs and the unsaved-changes prompt.
command file.save_as
wait 3
capture 12-save-as
cancel
command file.quit
wait 3
capture 13-quit-prompt
cancel
# Sound designer: a new ZzfxStream resource, a preset, Export .wav (default name), then Play on the file from the
# FileSystem panel (stop badge). The files are removed again.
edit-file Content/Audio/QaSound.mres {"format":2,"type":"ZzfxStream"}
inspect Examples/Demo/Content/Audio/QaSound.mres
wait 3
inspector-header zzfx-preset:pickup
wait 3
capture 13b-sound-designer
inspector-header zzfx-export
wait 3
accept
wait 3
fs-select Content/Audio/QaSound.wav
command fs.play
wait 3
capture 13c-sound-preview
command fs.stop
inspector-header inspector-close
delete-file Content/Audio/QaSound*
wait 3
# Song tab (music editor): a new song, a clip with notes (piano roll), the mixer while playing, Render, then the
# output previewed from the FileSystem panel. The files are removed again.
song new Content/Music/QaSong.msong
wait 3
song demo
wait 5
capture 13d-song-piano-roll
song panel mixer
song play
wait 30
capture 13e-song-mixer
song stop
song save
song render
wait-for render 60
wait 3
fs-select Content/Music/QaSong.wav
command fs.play
wait 3
capture 13f-song-render
command fs.stop
command file.close
wait 3
delete-file Content/Music/QaSong*
wait 3
# The update badge and dialog (a preview: QA runs never touch the network).
update-preview 9.9.9
wait 3
capture 14-update
cancel
# Editor Settings, with its Updates row.
command editor.settings
wait 3
capture 15-editor-settings
click #es-cancel
wait 3
state
quit
