# README screenshots (just readme-screenshots): raw 2x captures into artifacts/readme-screenshots; the recipe downscales
# them into docs/images. Projects live under the neutral /tmp/MainframeProjects (no user paths on screen): the recipe
# links Examples/Demo there and the workflow part creates MyGame there.
wait 30
# 1. The Project Manager with a few recent projects.
recent-project /tmp/MainframeProjects/Demo Demo 0.2
recent-project /tmp/MainframeProjects/SpaceMiner SpaceMiner 26
recent-project /tmp/MainframeProjects/PuzzleBox PuzzleBox 120
move 900 600
wait 20
capture editor-project-manager
# 2. The Demo's Basic 3D scene (the project's main scene opens with it): a light selected, debug lines filtered out, the Play tooltip showing.
open-project /tmp/MainframeProjects/Demo
wait-for project 300
wait 40
click #level-debug
collapse Ring
select Lights/WarmSpot
camera -0.3 0.9 -0.8 8.8 -18 -16
move #play
wait 60
capture editor
# 3. The create dialog: a favourite, a recent type (added and undone), a search and a description.
move 800 500
key A cmd
wait 5
search Omni
pick OmniLight3D
accept
wait 5
key Z cmd
wait 5
key A cmd
wait 5
favorite MeshInstance3D
favorite RigidBody3D
search Body3D
pick RigidBody3D
click 900 640 # the description pane: the search field's focus tooltip goes away
wait 30
capture editor-add-node
cancel
wait 5
state
# 4. Audio: the sound designer on a Demo ZzFX preset, then the Demo's song in a song tab (the Lead clip in the piano
# roll). Paths are relative to the checkout: the project is open under its real path.
inspect Examples/Demo/Assets/Audio/Sfx/explosion.mres
wait 10
clear-output
move 800 500
wait 10
capture editor-sound-designer
inspector-header inspector-close
open Examples/Demo/Assets/Music/demo_loop.msong
wait 10
song select 1
move 1500 700
wait 20
capture editor-song
# The built-in effects: the Channel EQ on the master with its curve; then the Browser and the mixer's insert slots
# (undone again: the Demo's song stays as it is on disk).
song insert master eq lowCutOn=1 lowCutFreq=60 peak2Freq=900 peak2Gain=3 peak3Freq=3000 peak3Gain=-4 peak3Q=2.5 highShelfGain=2.5
song insert 1 compressor threshold=-24 ratio=3
song fx-window master 0
move 1500 700
wait 20
capture editor-song-effects
song fx-close
song browser on
song browser-toggle vst
song browser-toggle vsti
song pane mixer
wait 20
capture editor-song-browser
song browser-toggle vst
song browser-toggle vsti
song browser off
song pane roll
command edit.undo
command edit.undo
command edit.undo
command edit.undo
wait 5
# The wavetable synth on the Lead track with a factory preset (stacked wavetables, LFO 1 in the editor), playing so the
# modulated knobs show their live dots; undone again.
song synth 1
song synth-preset 1 Evolving Pad
song synth-page osc 4
song play
move 1500 700
wait 90
capture editor-song-synth
song stop
song synth-close
command edit.undo
command edit.undo
wait 5
# 5. Video mode: the recipe's narrated Physics 2D recording (build/readme-video-clip.sh) with its silences and filler
# words cut and a transcript, the playhead stopped at 2.8 s as the bodies fall through the pegs. base.en (the default,
# 148 MB on first use) because tiny.en's looser word timings leave cut words unstruck in the transcript.
mode video
open /tmp/MainframeProjects/Recordings/demo.mp4
wait-for video-jobs 60
wait 10
command video.detect_silence
wait-for video-jobs 60
wait 10
video set whisper-model base.en
command video.transcribe
wait-for video-jobs 900
wait 10
command video.remove_fillers
wait 10
command video.play
wait-for video-position 2.8 60
command video.play
wait 20
move 1500 700
wait 20
capture editor-video
# Save the edit (Save As defaults to Recordings/demo.mfcut) so closing the tab asks nothing and Play below has nothing
# unsaved to write.
command file.save_as
wait 10
accept
wait 10
command file.close
wait 10
mode game
wait 10
# 6. The game workflow: create MyGame, add an [Export] property to its C#, Build & Reload, play it.
command project.new
wait 10
new-project /tmp/MainframeProjects MyGame
wait 30 # the .NET SDK check enables Create
click #np-create
wait-for project 300
wait 20
clear-output
replace-in-file MyGame/Src/Spinner.cs =\s45f; = 45f;\n\n/// <summary>Bobbing height, in metres.</summary>\n[Export(Range = "0,10,0.1")]\npublic float Wobble { get; set; } = 2.5f;
command project.build_reload
wait 3
wait-for idle 120
wait 10
select Spinner
camera 0 0.6 0 4.6 -38 -18
play-args --hidden
wait-for playing 120
wait 30
move 800 500
wait 10
capture editor-game-project
command play.stop
wait-for stopped 30
quit
