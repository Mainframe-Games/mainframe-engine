<Project Sdk="Microsoft.NET.Sdk">

  <!-- BenchmarkDotNet suite; run with "just bench" (Release build, see docs/design/testing.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet generates and builds its own project per run; keep ours optimised and quiet. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <!-- BenchmarkHost builds the benchmarks from this file rather than searching the repository for it (the search
       also finds the copies in .claude/worktrees and then fails). -->
  <ItemGroup>
    <AssemblyMetadata Include="BenchmarkProjectFile" Value="$(MSBuildProjectFullPath)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
    <!-- Localization benchmarks compile their catalogs with mf-l10n's .mo writer. -->
    <ProjectReference Include="..\..\Tools\MainframeEngine.L10n\MainframeEngine.L10n.csproj" />
    <!-- Registers the benchmark node types ([Replicated] boxes) like a game assembly. -->
    <ProjectReference Include="..\..\MainframeEngine.Generators\MainframeEngine.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
