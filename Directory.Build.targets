<Project>
  <!--
    Imported after each project file, so these settings win over the project's own (the vendored
    spine-csharp.csproj enables nullable itself). Vendored code is upstream's to fix: keep its
    nullable annotations but drop the warnings, the analyzers and warnings-as-errors.
  -->
  <PropertyGroup Condition="'$(IsVendoredProject)' == 'true'">
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RunAnalyzers>false</RunAnalyzers>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- This project's $(Version), for build-time lock-step checks (the editor checks the engine core it references). -->
  <Target Name="GetMainframeVersion" Returns="$(Version)" />

  <!--
    BRUTAL's analyzers stay off in every project here (ADR 0192). ExcludeAssets="analyzers" on the engine's references
    keeps them out of the lock file, but the SDK still resolves Ahwoo.BRUTAL.Core's (BRUTALCORE*) through the packages
    that depend on it, and projects referencing the engine get them transitively; remove them by package id.
  -->
  <Target Name="_MainframeRemoveBrutalAnalyzers" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="$([System.String]::Copy('%(Analyzer.NuGetPackageId)').StartsWith('Ahwoo.BRUTAL.'))" />
    </ItemGroup>
  </Target>
</Project>
