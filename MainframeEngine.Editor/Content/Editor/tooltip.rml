<rml>
<head>
    <title>Tooltip</title>
    <link type="text/rcss" href="/Content/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* A full-window overlay that never takes the mouse: only the tooltip box draws. */
        body.tooltip-layer {
            position: absolute;
            left: 0dp;
            top: 0dp;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        #tip {
            position: absolute;
            left: 0dp;
            top: 0dp;
            max-width: 340dp;
            padding: 5dp 8dp 6dp 8dp;
            background-color: #0d0f13f2;
            border: 1dp #3b3f4b;
            border-radius: 4dp;
            box-shadow: #00000099 0dp 4dp 12dp 0dp;
            color: #d7dbe4;
            font-size: 12dp;
            line-height: 16dp;
            white-space: normal;
            visibility: hidden;
        }
        #tip.shown { visibility: visible; }
        .tip-head { display: block; }
        .tip-title { font-weight: bold; color: #ffffff; }
        .tip-key {
            margin-left: 6dp;
            padding: 0dp 4dp;
            border: 1dp #3b3f4b;
            border-radius: 3dp;
            color: #93c5fd;
            font-family: "Roboto Mono";
            font-size: 11dp;
        }
        .tip-desc { display: block; margin-top: 2dp; color: #b4bccc; }
        .tip-line { display: block; color: #b4bccc; }
    </style>
</head>
<body class="tooltip-layer">
    <div id="tip"></div>
</body>
</rml>
