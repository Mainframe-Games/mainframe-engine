<rml>
<head>
    <title>Video</title>
    <link type="text/rcss" href="/Content/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* Video mode's view, below the tab strip: the preview and the transcript side by side, the notice line, and the
           timeline. The preview and the timeline are images of the tab's sub-viewports (VideoView); they let the mouse
           through to the VideoView node. Without a video tab: how to get a recording, and the recent videos. */
        body.video-doc { background-color: #15171c; pointer-events: none; }
        #video-recent, #video-split-v, #video-split-h, #video-transcript, #video-notice, #video-notice-link { pointer-events: auto; }

        #video-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1 1 auto;
            padding: 0dp 24dp;
            text-align: center;
            color: #6b7488;
        }
        #video-empty .icon { margin-bottom: 8dp; image-color: #4b5263; }
        #video-recent { display: flex; flex-direction: column; align-items: stretch; margin-top: 14dp; width: 360dp; }
        .recent-row {
            display: flex; flex-direction: row; align-items: center; height: 26dp; padding: 0dp 8dp;
            border-radius: 3dp; color: #a3abbd; text-align: left; cursor: pointer; white-space: nowrap; overflow: hidden;
        }
        .recent-row:hover { background-color: #262931; color: #ffffff; }
        .recent-row .icon { margin: 0dp 8dp 0dp 0dp; image-color: #8b93a5; }

        #video-main { display: flex; flex-direction: column; flex: 1 1 auto; }
        #video-upper { display: flex; flex-direction: row; flex: 1 1 auto; min-height: 40dp; }
        .canvas { display: block; position: relative; pointer-events: none; overflow: hidden; }
        #video-preview { flex: 1 1 auto; background-color: #0b0c0f; }
        #video-preview-image { display: block; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
        .splitter { flex: 0 0 5dp; background-color: #15171c; drag: drag; }
        .splitter:hover, .splitter.dragging { background-color: #3b82f6; }
        #video-split-v { width: 5dp; cursor: ew-resize; }
        #video-split-h { height: 5dp; cursor: ns-resize; }
        #video-transcript { display: flex; flex-direction: column; flex: 0 0 auto; width: 320dp; overflow: hidden; background-color: #1b1d23; }
        /* The words scroll under the fixed header: flowing text in paragraphs that break at a long pause. */
        #video-transcript-words { flex: 1 1 auto; overflow-y: auto; padding: 8dp 10dp; }
        .transcript-empty { padding: 8dp 4dp; line-height: 18dp; }
        .hint { color: #8b93a5; }
        .para { display: block; margin-bottom: 10dp; line-height: 22dp; font-size: 14dp; color: #e6e6ec; }
        .w { padding: 1dp 1dp; border-radius: 2dp; cursor: pointer; }
        .w:hover { background-color: #2a2d36; }
        .w.cut { color: #6a6a75; text-decoration: line-through; }
        .w.cur { background-color: #2f4f82; color: #ffffff; }
        .w.sel { background-color: #5b8def; color: #ffffff; }
        /* One line, in the song tab's notice colours (amber on dark amber). */
        #video-notice {
            flex: 0 0 auto; height: 22dp; line-height: 22dp; margin: 0dp; padding: 0dp 10dp; border-width: 0dp; border-radius: 0dp;
            background-color: #3a2a0d; color: #fcd34d; font-size: 12dp; white-space: nowrap; overflow: hidden;
        }
        /* "ffmpeg not found" ends in a link to the setting (video.settings). */
        #video-notice-link { margin-left: 6dp; color: #ffffff; text-decoration: underline; cursor: pointer; }
        #video-notice-link:hover { color: #fde68a; }
        #video-timeline { flex: 0 0 auto; height: 180dp; background-color: #121215; }
        #video-timeline-image { display: block; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
    </style>
</head>
<body class="panel-doc video-doc" data-model="video">
    <div id="video-empty" data-if="!has_tab">
        <span class="icon icon-lg icon-video"></span>
        <span>Open a recording (File › Open…) or record one in Game mode (F10)</span>
        <div id="video-recent">
            <div class="recent-row" data-for="r : recent" data-attr-data-command="'video.recent:' + r.index" data-attr-data-tooltip="r.path"><span class="icon icon-sm icon-video"></span><span>{{r.name}}</span></div>
        </div>
    </div>
    <div id="video-main" data-if="has_tab">
        <div id="video-upper">
            <div id="video-preview" class="canvas"><img id="video-preview-image"/></div>
            <div id="video-split-v" class="splitter" data-if="show_transcript"></div>
            <div id="video-transcript" data-if="show_transcript">
                <div class="panel-header"><span class="panel-title">Transcript</span></div>
                <div id="video-transcript-words"><div class="transcript-empty hint">No transcript yet. Transcribe to edit by text.</div></div>
            </div>
        </div>
        <div id="video-notice" class="notice" data-if="notice != ''" data-attr-data-tooltip="notice">{{notice}}<span id="video-notice-link" data-if="notice_ffmpeg" data-command="video.settings" data-tooltip="Editor Settings › Video › ffmpeg — set where ffmpeg is">Editor Settings</span></div>
        <div id="video-split-h" class="splitter"></div>
        <div id="video-timeline" class="canvas"><img id="video-timeline-image"/></div>
    </div>
</body>
</rml>
