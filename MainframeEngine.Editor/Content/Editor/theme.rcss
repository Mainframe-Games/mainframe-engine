/*
 * Mainframe Editor theme (docs/design/editor.md#ui). Built on the shared widget library (widgets.rcss), recoloured to the
 * editor's dark palette and tightened for dense tool panels. Every panel is its own document, absolutely positioned
 * by EditorLayout (body left/top/width/height in dp).
 *
 * Palette: base #15171c · panel #1f2128 · raised #262931 · field #121418 · line #2f333d · hover #343947
 *          text #d7dbe4 · muted #8b93a5 · accent #3b82f6 (selection #1d4ed8) · warn #f59e0b · error #ef4444
 */

body {
    font-family: LatoLatin;
    font-size: 13dp;
    color: #d7dbe4;
}

div, p, section, header, footer, h1, h2, h3, label.block { display: block; }
span, b, i, em, strong { display: inline; }
b, strong { font-weight: bold; }
i, em { font-style: italic; }
.mono { font-family: "Roboto Mono"; font-size: 12dp; }
.muted { color: #8b93a5; }
.grow { flex: 1 1 auto; }
.hidden { display: none; }

/* ── Panels ─────────────────────────────────────────────────────────────── */

body.panel-doc {
    position: absolute;
    display: flex;
    flex-direction: column;
    background-color: #1f2128;
    pointer-events: auto;
    overflow: hidden;
}

.panel-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex: 0 0 auto;
    height: 28dp;
    padding: 0dp 8dp;
    background-color: #262931;
    border-bottom: 1dp #2f333d;
}

.panel-title {
    flex: 1 1 auto;
    font-weight: bold;
    color: #e8ebf2;
    font-size: 12dp;
    letter-spacing: 0.5dp;
}

.panel-body {
    flex: 1 1 auto;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 4dp 0dp;
}

.panel-placeholder {
    padding: 16dp 14dp;
    color: #8b93a5;
    line-height: 18dp;
}

/* ── Buttons ────────────────────────────────────────────────────────────── */

button, .btn {
    display: inline-block;
    height: 22dp;
    line-height: 22dp;
    padding: 0dp 9dp;
    margin-left: 2dp;
    background-color: #2f333d;
    border: 1dp #3b3f4b;
    border-radius: 3dp;
    color: #d7dbe4;
    font-size: 12dp;
    text-align: center;
    cursor: pointer;
    pointer-events: auto;
    tab-index: none;
}

button:hover, .btn:hover { background-color: #3a3f4c; border-color: #4b5263; }
button:active, .btn:active { background-color: #23262e; }
button.active, .btn.active { background-color: #1d4ed8; border-color: #3b82f6; color: #ffffff; }
button.primary { background-color: #2563eb; border-color: #3b82f6; color: #ffffff; }
button.primary:hover { background-color: #3b82f6; }
button.danger { background-color: #7f1d1d; border-color: #b91c1c; color: #ffffff; }
button:disabled, button.disabled { color: #5f6676; background-color: #23262e; border-color: #2a2d36; cursor: unavailable; }
button.small { height: 18dp; line-height: 18dp; padding: 0dp 6dp; font-size: 11dp; }

/* ── Fields ─────────────────────────────────────────────────────────────── */

input.text, textarea {
    display: inline-block;
    box-sizing: border-box;
    height: 22dp;
    line-height: 14dp;
    padding: 3dp 6dp;
    background-color: #121418;
    border: 1dp #2f333d;
    border-radius: 3dp;
    color: #e8ebf2;
    font-size: 12dp;
    cursor: text;
    pointer-events: auto;
    tab-index: auto;
}

textarea { height: 64dp; line-height: 16dp; }
input.text:hover, textarea:hover { border-color: #4b5263; }
input.text:focus, textarea:focus { border-color: #3b82f6; background-color: #0e1013; }
input.text selection, textarea selection { background-color: #1d4ed8; color: #ffffff; }
input.text:placeholder-shown, textarea:placeholder-shown { color: #5f6676; }

input.checkbox {
    display: inline-block;
    box-sizing: border-box;
    width: 15dp;
    height: 15dp;
    vertical-align: middle;
    background-color: #121418;
    border: 1dp #4b5263;
    border-radius: 3dp;
    cursor: pointer;
    pointer-events: auto;
}

input.checkbox:hover { border-color: #6b7488; }
input.checkbox:checked { background-color: #3b82f6; border-color: #3b82f6; decorator: image(/Content/UI/widgets/images/check.png contain); }

input.range {
    display: inline-block;
    height: 16dp;
    vertical-align: middle;
    pointer-events: auto;
    cursor: pointer;
}

input.range slidertrack { margin-top: 6dp; height: 4dp; background-color: #121418; border-radius: 2dp; }
input.range sliderprogress { height: 4dp; background-color: #3b82f6; border-radius: 2dp; }
input.range sliderbar { width: 12dp; height: 12dp; margin-top: 2dp; margin-left: -6dp; margin-right: -6dp; background-color: #d7dbe4; border-radius: 6dp; }
input.range sliderbar:hover { background-color: #ffffff; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0dp; height: 0dp; }

select {
    display: inline-block;
    box-sizing: border-box;
    height: 22dp;
    background-color: #121418;
    border: 1dp #2f333d;
    border-radius: 3dp;
    font-size: 12dp;
    text-align: left;
    pointer-events: auto;
    cursor: pointer;
}

select:hover { border-color: #4b5263; }
select selectvalue { margin-right: 18dp; padding: 3dp 6dp; height: 14dp; line-height: 14dp; }
select selectarrow { width: 18dp; height: 20dp; decorator: image(/Content/UI/widgets/images/arrow-down.png contain); image-color: #8b93a5; }
select selectbox { margin-top: 1dp; padding: 3dp 0dp; background-color: #262931; border: 1dp #3b3f4b; border-radius: 3dp; }
select selectbox option { padding: 3dp 8dp; line-height: 16dp; }
select selectbox option:hover { background-color: #1d4ed8; color: #ffffff; }
select selectbox option:checked { font-weight: bold; }

/* ── Scrollbars ─────────────────────────────────────────────────────────── */

scrollbarvertical { width: 8dp; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { background-color: #3b3f4b; border-radius: 4dp; min-height: 24dp; }
scrollbarvertical sliderbar:hover { background-color: #4b5263; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0dp; }
scrollbarhorizontal { height: 8dp; }
scrollbarhorizontal slidertrack { background-color: transparent; }
scrollbarhorizontal sliderbar { background-color: #3b3f4b; border-radius: 4dp; }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0dp; }

/* ── Icons (docs/design/editor.md#icons) ──────────────────────────────────
 * Markup: <span class="icon icon-NAME"/> (NAME: a Tabler icon in Content/icons/icons.txt; sprites in icons.rcss,
 * linked by every document). White glyphs tinted with image-color. Size: icon-sm 14dp · default 16dp · icon-lg 24dp.
 * Families (Godot-style, picked to read on #1f2128): 3d red · 2d blue · ui green · audio teal · physics amber ·
 * net purple · logic grey · resource neutral. Icons over text: icon-only controls carry data-tooltip.
 */

.icon {
    display: inline-block;
    flex: 0 0 auto;
    width: 16dp;
    height: 16dp;
    vertical-align: middle;
    image-color: #c9cedb;
}

.icon-sm { width: 14dp; height: 14dp; }
.icon-lg { width: 24dp; height: 24dp; }

.icon-3d { image-color: #fc7f7f; }
.icon-2d { image-color: #8da5f3; }
.icon-ui { image-color: #8eef97; }
.icon-audio { image-color: #5eead4; }
.icon-physics { image-color: #fbbf24; }
.icon-net { image-color: #c4a5ff; }
.icon-logic { image-color: #a3abbd; }
.icon-resource { image-color: #e2e6ee; }
.icon-dir { image-color: #e8c15a; }
.icon-missing { image-color: #f87171; }
.icon-muted { image-color: #6b7488; }
.icon-accent { image-color: #60a5fa; }
.icon-info { image-color: #93c5fd; }
.icon-warn { image-color: #fbbf24; }
.icon-error { image-color: #f87171; }
.icon-debug { image-color: #8b93a5; }

/* Icon-only buttons (toolbar, panel headers, row actions): square, the glyph centred; .active keeps the toggle look. */
button.tool-button, .btn.tool-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24dp;
    height: 24dp;
    line-height: 24dp;
    padding: 0dp;
}

button.tool-button.small { width: 20dp; height: 20dp; line-height: 20dp; }
button.tool-button .icon { image-color: #c9cedb; }
button.tool-button:hover .icon { image-color: #ffffff; }
button.tool-button.active .icon { image-color: #ffffff; }
button.tool-button.disabled .icon, button.tool-button:disabled .icon { image-color: #4b5263; }

/* Buttons with an icon and a label. */
button.with-icon { display: inline-flex; align-items: center; }
button.with-icon .icon { margin-right: 5dp; }

/* Flat icon buttons inside rows (no frame until hovered). */
.flat-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20dp;
    height: 20dp;
    border-radius: 3dp;
    cursor: pointer;
    pointer-events: auto;
}

.flat-button:hover { background-color: #3a3f4c; }
.flat-button .icon { image-color: #8b93a5; }
.flat-button:hover .icon { image-color: #ffffff; }

/* Expand arrow (chevron icon), turned for collapsed rows. */
.arrow {
    display: inline-block;
    flex: 0 0 auto;
    width: 14dp;
    height: 14dp;
    vertical-align: middle;
    decorator: image(i-chevron-down);
    image-color: #8b93a5;
    cursor: pointer;
}

.arrow.collapsed { decorator: image(i-chevron-right); }
.arrow.none { decorator: none; cursor: auto; }
.arrow:hover { image-color: #e8ebf2; }

.notice {
    margin: 6dp 8dp;
    padding: 6dp 8dp;
    background-color: #3a2f12;
    border: 1dp #6b5310;
    border-radius: 3dp;
    color: #fde68a;
    line-height: 16dp;
}

.error-text { color: #fca5a5; }
