<rml>
<head>
    <title>Toolbar</title>
    <link type="text/rcss" href="/Content/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        body.toolbar {
            flex-direction: row;
            align-items: center;
            padding: 0dp 8dp;
            background-color: #1b1d23;
            border-bottom: 1dp #2a2d36;
        }
        .group {
            display: flex;
            flex-direction: row;
            align-items: center;
            padding: 0dp 6dp;
            margin-right: 6dp;
            border-right: 1dp #2a2d36;
        }
        .group button.tool-button { width: 28dp; height: 26dp; line-height: 26dp; }
        .spacer { flex: 1 1 auto; }
        #snap-step { width: 46dp; margin-left: 4dp; }
        #update { display: none; margin-right: 6dp; }
        #update.shown { display: inline-block; }
        #update .icon { image-color: #4ade80; }
        #stats { padding: 0dp 10dp 0dp 6dp; color: #8b93a5; white-space: nowrap; }
        .play button.tool-button { width: 32dp; }
        #play .icon { image-color: #4ade80; }
        #play.disabled .icon, #pause.disabled .icon, #stop.disabled .icon { image-color: #4b5263; }
        .play button.attention { border-color: #f59e0b; }
        .play button.busy { background-color: #3a2f12; border-color: #b45309; }
        #instances { display: flex; flex-direction: row; align-items: center; }
        .instance {
            display: flex;
            flex-direction: row;
            align-items: center;
            height: 22dp;
            margin-left: 4dp;
            padding: 0dp 6dp 0dp 4dp;
            border: 1dp #3b3f4b;
            border-radius: 11dp;
            background-color: #23262e;
            font-size: 11dp;
            cursor: pointer;
        }
        .instance:hover { border-color: #4b5263; }
        .instance.running { border-color: #15803d; }
        .instance.paused { border-color: #b45309; }
        .instance.crashed { border-color: #b91c1c; }
        .instance.exited { color: #6b7488; }
        #play-status { margin-left: 6dp; font-size: 11dp; white-space: nowrap; }
    </style>
</head>
<body class="panel-doc toolbar">
    <div class="group">
        <button id="tool-select" class="tool-button" data-command="gizmo.select" data-tooltip="Select (Q) — pick nodes in the viewport without a gizmo"><span class="icon icon-pointer"></span></button>
        <button id="tool-translate" class="tool-button" data-command="gizmo.translate" data-tooltip="Move (W) — translate selected nodes"><span class="icon icon-arrows-move"></span></button>
        <button id="tool-rotate" class="tool-button" data-command="gizmo.rotate" data-tooltip="Rotate (E) — rotate selected nodes"><span class="icon icon-rotate"></span></button>
        <button id="tool-scale" class="tool-button" data-command="gizmo.scale" data-tooltip="Scale (R) — scale selected nodes"><span class="icon icon-arrows-maximize"></span></button>
    </div>
    <div class="group">
        <button id="tool-local" class="tool-button" data-command="gizmo.local" data-tooltip="Global Space (T) — handles follow the world axes; click for the node's local axes"><span id="tool-local-icon" class="icon icon-world"></span></button>
        <button id="tool-snap" class="tool-button" data-command="gizmo.snap" data-tooltip="Snap (Y) — move, rotate and scale in steps"><span class="icon icon-magnet"></span></button>
        <input type="text" class="text" id="snap-step" value="0.5" data-tooltip="Snap Step — the move step in metres (rotation snaps to 15°, scale to 0.1)"/>
    </div>
    <div class="group">
        <button id="tool-frame" class="tool-button" data-command="view.frame" data-tooltip="Frame Selection (F) — move the camera to the selected nodes"><span class="icon icon-focus-centered"></span></button>
        <button id="tool-grid" class="tool-button active" data-command="view.grid" data-tooltip="Grid (G) — show or hide the ground grid"><span class="icon icon-grid-3x3"></span></button>
        <button id="tool-post" class="tool-button active" data-command="view.post" data-tooltip="Preview Post-Processing — show the world's post effects in the view (tonemap, auto exposure, glow, SSAO, TAA, grade, depth of field, film); off: the plain tonemap"><span class="icon icon-sparkles"></span></button>
    </div>
    <div class="spacer"></div>
    <div class="group play">
        <button id="play" class="tool-button" data-command="play.main" data-tooltip="Play (F5) — build the project and run its main scene"><span class="icon icon-player-play-filled"></span></button>
        <button id="play-scene" class="tool-button" data-command="play.scene" data-tooltip="Play Scene (F6) — save and run the open scene"><span class="icon icon-movie"></span></button>
        <button id="pause" class="tool-button disabled" data-command="play.pause" data-tooltip="Pause (F7) — pause or resume the running game"><span class="icon icon-player-pause"></span></button>
        <button id="stop" class="tool-button disabled" data-command="play.stop" data-tooltip="Stop (F8) — stop every running game"><span class="icon icon-player-stop"></span></button>
        <button id="build-reload" class="tool-button" data-command="project.build_reload" data-tooltip="Build &amp; Reload (Ctrl+Shift+B) — compile the game's C# and reload it in the editor"><span class="icon icon-hammer"></span></button>
        <div id="instances"></div>
        <span id="play-status" class="muted"></span>
    </div>
    <div class="spacer"></div>
    <button id="update" class="tool-button" data-command="help.update" data-tooltip="Update available"><span class="icon icon-arrow-bar-to-down"></span></button>
    <span id="stats" class="mono" data-tooltip="Frame Rate — editor frames per second and frame time"></span>
</body>
</rml>
