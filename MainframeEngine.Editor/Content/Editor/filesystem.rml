<rml>
<head>
    <title>FileSystem</title>
    <link type="text/rcss" href="/Content/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body class="panel-doc">
    <div class="panel-header">
        <span class="icon icon-folder title-icon" style="margin-right: 6dp; image-color: #8b93a5;"></span>
        <span class="panel-title">FileSystem</span>
    </div>
    <div class="panel-body">
        <div class="panel-placeholder">
            <span class="icon icon-lg icon-folder-cog icon-muted" style="display: block; margin-bottom: 8dp;"></span>
            The project's <span class="mono">Content/</span> browser arrives with projects (E4).
            <br/><br/>
            Project folder:<br/><span class="mono" id="project-root">none</span>
        </div>
    </div>
</body>
</rml>
