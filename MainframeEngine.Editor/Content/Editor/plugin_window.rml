<rml>
<head>
    <title>Plugin</title>
    <link type="text/rcss" href="/Content/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* A built-in effect's window in music mode (PluginWindow): floating over the song view, never modal. The body
           covers the editor and lets the mouse through; only the window takes it. Knobs and their sections are built from
           the effect's parameter descriptors; the EQ draws its curve in a canvas view (engine://plugin-graph). Sizes here
           are the constants PluginWindow maps mouse positions with (title 30dp, graph margin 10dp, border 1dp). */
        body.plugin-doc { position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; pointer-events: none; }
        #pw-window {
            position: absolute; display: flex; flex-direction: column; pointer-events: auto;
            background-color: #1f2128; border: 1dp #3b3f4b; border-radius: 6dp; box-shadow: #000000a0 0dp 10dp 30dp 0dp;
        }
        #pw-title {
            display: flex; flex-direction: row; align-items: center; flex: 0 0 30dp; height: 30dp; padding: 0dp 6dp 0dp 10dp;
            background-color: #262931; border-bottom: 1dp #2f333d; border-radius: 6dp 6dp 0dp 0dp; cursor: move; drag: drag;
            white-space: nowrap;
        }
        #pw-title .icon { margin-right: 8dp; image-color: #8b93a5; }
        #pw-name { flex: 1 1 auto; width: 40dp; min-width: 0dp; overflow: hidden; color: #ffffff; font-weight: bold; font-size: 12dp; }
        #pw-title button { margin-left: 4dp; }
        #pw-title button.text-button { height: 22dp; line-height: 22dp; padding: 0dp 8dp; font-size: 11dp; }
        button.tool-button.small.pw-power.active { background-color: #166534; border-color: #22c55e; }
        #pw-window.bypassed #pw-body, #pw-window.bypassed #pw-graph { opacity: 0.45; }
        #pw-window.readonly #pw-body { opacity: 0.6; }

        #pw-graph { display: block; position: relative; flex: 0 0 auto; margin: 10dp 10dp 0dp 10dp; height: 190dp;
                    background-color: #15171c; border: 1dp #2f333d; border-radius: 3dp; drag: drag; cursor: crosshair; }
        #pw-graph img { display: block; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
        #pw-graph.hidden, #pw-meter.hidden, #pw-readout.hidden, #pw-power.hidden, #pw-presets.hidden { display: none; }

        #pw-meter { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; margin: 10dp 10dp 0dp 10dp; height: 18dp;
                    color: #8b93a5; font-size: 11dp; }
        #pw-meter-label { width: 96dp; }
        #pw-meter-bar { display: block; position: relative; flex: 1 1 auto; height: 8dp; background-color: #121418; border: 1dp #2f333d; }
        #pw-meter-fill { display: block; position: absolute; right: 0dp; top: 0dp; height: 100%; width: 0%; background-color: #f59e0b; }
        #pw-meter-db { width: 64dp; text-align: right; color: #d7dbe4; }
        #pw-readout { display: block; flex: 0 0 auto; margin: 10dp 10dp 0dp 10dp; padding: 6dp 8dp; background-color: #15171c;
                      border: 1dp #2f333d; border-radius: 3dp; color: #d7dbe4; font-size: 12dp; }

        #pw-body { display: flex; flex-direction: row; flex-wrap: wrap; align-items: flex-start; flex: 0 0 auto; padding: 6dp 6dp 10dp 6dp;
                   max-height: 600dp; overflow-y: auto; }
        .pw-section { display: flex; flex-direction: column; align-items: center; margin: 4dp; padding: 4dp 4dp 6dp 4dp;
                      background-color: #262931; border: 1dp #2f333d; border-radius: 4dp; }
        .pw-section.band { width: 70dp; }
        .pw-section-title { height: 16dp; line-height: 16dp; color: #a3abbd; font-size: 10.5dp; white-space: nowrap; margin-bottom: 2dp; }
        .pw-section-title .swatch { display: inline-block; width: 8dp; height: 8dp; border-radius: 4dp; margin-right: 4dp; }
        .pw-knobs { display: flex; flex-direction: row; flex-wrap: wrap; justify-content: center; }
        .pw-section.band .pw-knobs { flex-direction: column; align-items: center; }

        .knob { display: flex; flex-direction: column; align-items: center; width: 62dp; margin: 2dp 0dp; }
        .knob-dial { display: block; position: relative; width: 38dp; height: 38dp; border-radius: 19dp; background-color: #15171c;
                     border: 2dp #4b5263; drag: drag; cursor: ns-resize; }
        .knob-dial:hover { border-color: #6b7488; }
        .knob-dial.dragging { border-color: #3b82f6; }
        .knob-pointer { display: block; position: absolute; left: 16dp; top: 3dp; width: 2dp; height: 13dp; background-color: #e8ebf2;
                        border-radius: 1dp; transform-origin: 1dp 14dp; }
        .knob-name { margin-top: 3dp; color: #a3abbd; font-size: 10dp; white-space: nowrap; }
        .knob-value { color: #e8ebf2; font-size: 10.5dp; white-space: nowrap; }

        .pw-toggle, .pw-choice {
            display: block; height: 20dp; line-height: 20dp; margin: 3dp 2dp; padding: 0dp 8dp; border-radius: 3dp;
            background-color: #15171c; border: 1dp #3b3f4b; color: #a3abbd; font-size: 10.5dp; white-space: nowrap; cursor: pointer;
            text-align: center;
        }
        .pw-toggle:hover, .pw-choice:hover { border-color: #6b7488; color: #ffffff; }
        .pw-toggle.active { background-color: #1e3a5f; border-color: #3b82f6; color: #ffffff; }
        .pw-param-name { display: block; color: #8b93a5; font-size: 9.5dp; text-align: center; margin-top: 2dp; }
        .pw-choice-wrap { display: flex; flex-direction: column; align-items: center; width: 62dp; margin: 2dp 0dp; }
    </style>
</head>
<body class="plugin-doc">
    <div id="pw-window">
        <div id="pw-title">
            <span id="pw-icon" class="icon icon-sm icon-adjustments-horizontal"></span>
            <span id="pw-name">Effect</span>
            <button id="pw-power" class="tool-button small pw-power active" data-tooltip="Bypass — off passes the sound through unchanged (crossfaded)"><span class="icon icon-sm icon-plug-connected"></span></button>
            <button id="pw-presets" class="text-button" data-tooltip="Presets — starting points for this effect">Presets</button>
            <button id="pw-reset" class="tool-button small" data-tooltip="Reset — every parameter to its default (one undo step)"><span class="icon icon-sm icon-refresh"></span></button>
            <button id="pw-close" class="tool-button small" data-tooltip="Close (Esc)"><span class="icon icon-sm icon-x"></span></button>
        </div>
        <div id="pw-graph" class="hidden" data-tooltip="Drag a handle: frequency and gain · wheel: Q · double-click: band on/off"><img id="pw-graph-image"/></div>
        <div id="pw-meter" class="hidden"><span id="pw-meter-label">Gain reduction</span><div id="pw-meter-bar"><div id="pw-meter-fill"></div></div><span id="pw-meter-db" class="mono">0.0 dB</span></div>
        <div id="pw-readout" class="hidden"></div>
        <div id="pw-body"></div>
    </div>
</body>
</rml>
