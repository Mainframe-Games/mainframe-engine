<rml>
<head>
    <title>Inspector</title>
    <link type="text/rcss" href="/Content/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        .insp-head {
            padding: 8dp 10dp 6dp 10dp;
            border-bottom: 1dp #2a2d36;
        }
        .insp-type { display: flex; flex-direction: row; align-items: center; margin-bottom: 6dp; color: #8b93a5; }
        .insp-icon { margin-right: 8dp; }
        .insp-type-name { display: block; flex: 1 1 auto; font-size: 13dp; font-weight: bold; color: #d7dbe4; }
        .t-3d { color: #fc7f7f; }
        .t-2d { color: #8da5f3; }
        .t-ui { color: #8eef97; }
        .t-audio { color: #5eead4; }
        .t-physics { color: #fbbf24; }
        .t-net { color: #c4a5ff; }
        .t-logic { color: #c9cedb; }
        .t-resource { color: #e2e6ee; }
        .t-missing { color: #f87171; }
        .insp-badge { display: inline-flex; align-items: center; padding: 0dp 5dp; height: 18dp; border-radius: 3dp;
                      background-color: #2f333d; color: #c9cedb; font-size: 11dp; }
        .insp-badge .icon { margin-right: 3dp; }
        .insp-instance { display: flex; flex-direction: row; align-items: center; margin-bottom: 6dp; color: #93c5fd; font-size: 11dp;
                         white-space: nowrap; overflow: hidden; }
        .insp-instance .icon { margin-right: 5dp; }
        .insp-name-row { display: flex; flex-direction: row; align-items: center; }
        .name-icon { margin-right: 6dp; }
        .insp-name-row input.text { flex: 1 1 auto; width: 100dp; font-weight: bold; }
        .section-title {
            display: flex;
            flex-direction: row;
            align-items: center;
            height: 24dp;
            padding: 0dp 6dp;
            margin-top: 4dp;
            background-color: #262931;
            color: #e8ebf2;
            font-weight: bold;
            font-size: 12dp;
            cursor: pointer;
        }
        .section-title:hover { background-color: #2f333d; }
        .section-title.nested { margin: 0dp 0dp 0dp 16dp; height: 22dp; font-size: 11dp; background-color: #1f2128; color: #c9cfdb; }
        .section-title.nested2 { margin: 0dp 0dp 0dp 28dp; height: 22dp; font-size: 11dp; background-color: #1c1e24; color: #c9cfdb; }
        .section-title.nested:hover, .section-title.nested2:hover { background-color: #2a2d36; }
        .section-icon { margin: 0dp 6dp 0dp 1dp; }
        .prop {
            display: flex;
            flex-direction: row;
            align-items: center;
            min-height: 26dp;
            padding: 2dp 8dp 2dp 12dp;
        }
        .prop.nested { padding-left: 24dp; background-color: #1b1d23; }
        .prop.nested2 { padding-left: 36dp; background-color: #18191e; }
        .prop-label {
            display: flex;
            flex-direction: row;
            align-items: center;
            flex: 0 0 auto;
            width: 120dp;
            color: #b4bccc;
            font-size: 12dp;
            white-space: nowrap;
            overflow: hidden;
        }
        .prop-icon { margin-right: 6dp; image-color: #8b93a5; }
        .prop-icon.icon-3d { image-color: #fc7f7f; }
        .prop-icon.icon-2d { image-color: #8da5f3; }
        .prop-icon.icon-ui { image-color: #8eef97; }
        .prop-icon.icon-audio { image-color: #5eead4; }
        .prop-icon.icon-physics { image-color: #fbbf24; }
        .prop-icon.icon-net { image-color: #c4a5ff; }
        .prop-icon.icon-resource { image-color: #e2e6ee; }
        .prop-icon.icon-missing { image-color: #f87171; }
        .prop-name { display: block; flex: 1 1 auto; overflow: hidden; }
        .prop-editor button.tool-button { margin-left: 2dp; flex: 0 0 auto; }
        .prop-editor { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; }
        .prop-editor input.text { flex: 1 1 auto; width: 30dp; margin-left: 2dp; }
        .prop-editor input.range { flex: 1 1 auto; width: 40dp; margin-right: 6dp; }
        .prop-editor input.range + input.text { flex: 0 0 auto; width: 54dp; }
        .prop-editor select { flex: 1 1 auto; width: 40dp; }
        .prop-editor textarea { flex: 1 1 auto; width: 40dp; }
        .axis { display: inline-block; width: 12dp; text-align: center; font-size: 10dp; font-weight: bold; }
        .axis.x { color: #f87171; }
        .axis.y { color: #4ade80; }
        .axis.z { color: #60a5fa; }
        .axis.w { color: #c4b5fd; }
        .readonly { color: #8b93a5; font-size: 12dp; }
        .swatch {
            display: block;
            width: 34dp;
            height: 18dp;
            margin-right: 4dp;
            border: 1dp #4b5263;
            border-radius: 3dp;
            cursor: pointer;
        }
        .flags { display: flex; flex-direction: row; flex-wrap: wrap; }
        .flag { display: flex; flex-direction: row; align-items: center; margin-right: 8dp; font-size: 11dp; color: #b4bccc; }
        .flag input.checkbox { margin-right: 3dp; }
        .res-label {
            display: flex;
            flex-direction: row;
            align-items: center;
            flex: 1 1 auto;
            height: 20dp;
            line-height: 20dp;
            padding: 0dp 6dp;
            background-color: #121418;
            border: 1dp #2f333d;
            border-radius: 3dp;
            font-size: 11dp;
            white-space: nowrap;
            overflow: hidden;
        }
        .res-icon { margin-right: 4dp; }
        .res-name { display: block; flex: 1 1 auto; min-width: 0dp; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
        /* A resource slot: the name takes its whole width; the buttons stay beside it while both fit, else they wrap onto
           a line of their own below it (right-aligned), and only a name longer than the row is cut with an ellipsis. */
        .prop-editor.res { flex-wrap: wrap; justify-content: flex-end; row-gap: 3dp; }
        .prop-editor.res .res-label { min-width: 0dp; }
        .res-actions { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; min-height: 22dp; }
        .array-item { display: flex; flex-direction: row; align-items: center; margin-top: 2dp; }
        .array-index { width: 20dp; color: #6b7488; font-size: 10dp; }
        .array-box { display: block; flex: 1 1 auto; }
        .empty { display: flex; flex-direction: column; align-items: center; padding: 26dp 12dp; color: #8b93a5; text-align: center; }
        .empty .icon { margin-bottom: 8dp; }
        .panel-header .title-icon { margin-right: 6dp; image-color: #8b93a5; }
        .color-picker { padding: 2dp 8dp 6dp 12dp; }
        .color-picker .prop { padding-left: 0dp; }
        .insp-multi { color: #b4bccc; font-size: 11dp; line-height: 15dp; }
        input.text.mixed { color: #8b93a5; }
        input.checkbox.mixed { background-color: #3b3f4b; border-color: #8b93a5; }
        .tabs { display: flex; flex-direction: row; flex: 0 0 auto; }
        .tabs button { width: 26dp; padding: 0dp; margin-left: 3dp; }
        .sig { padding: 0dp; }
        .sig-row {
            display: flex;
            flex-direction: row;
            align-items: center;
            height: 24dp;
            padding: 0dp 6dp 0dp 10dp;
            white-space: nowrap;
        }
        .sig-row:hover { background-color: #262931; }
        .sig-name { flex: 1 1 auto; color: #e8ebf2; font-size: 12dp; overflow: hidden; }
        .sig-params { color: #6b7488; font-size: 11dp; }
        .sig-conn {
            display: flex;
            flex-direction: row;
            align-items: center;
            height: 22dp;
            padding: 0dp 6dp 0dp 30dp;
            color: #b4bccc;
            font-size: 11dp;
            white-space: nowrap;
        }
        .sig-conn .grow { overflow: hidden; }
        .sig-flags { color: #8b93a5; margin-left: 4dp; }
        .res-file { display: block; flex: 1 1 auto; font-weight: bold; color: #e8ebf2; }
        .label-splitter {
            position: absolute;
            top: 28dp;
            bottom: 0dp;
            left: 130dp;
            width: 6dp;
            drag: drag;
            cursor: col-resize;
            pointer-events: auto;
        }
        .label-splitter:hover { background-color: #3b82f640; }
        .insp-name-row button { width: 24dp; padding: 0dp; margin-left: 4dp; }
        .mixer { display: block; margin: 6dp 8dp; padding: 6dp; background-color: #1b1d23; border: 1dp #2a2d36; border-radius: 4dp; }
        .mixer-title { display: flex; flex-direction: row; align-items: center; height: 24dp; font-weight: bold; color: #e8ebf2; }
        .mixer-title button { margin-left: auto; width: 22dp; padding: 0dp; }
        .mixer-bus { display: flex; flex-direction: row; align-items: center; height: 26dp; border-top: 1dp #23262e; }
        .mixer-name { display: block; width: 70dp; font-weight: bold; white-space: nowrap; overflow: hidden; }
        .mixer-send { display: block; flex: 1 1 auto; color: #8b93a5; font-size: 11dp; white-space: nowrap; overflow: hidden; }
        .mixer-db { display: block; width: 56dp; text-align: center; font-size: 11dp; }
        .mixer-bus button { width: 20dp; height: 20dp; line-height: 20dp; padding: 0dp; margin-left: 2dp; }
        .zzfx { display: block; margin: 6dp 8dp; padding: 6dp; background-color: #1b1d23; border: 1dp #2a2d36; border-radius: 4dp; }
        .zzfx-top { display: flex; flex-direction: row; align-items: center; height: 26dp; }
        .zzfx-top button { width: 26dp; height: 22dp; line-height: 22dp; padding: 0dp; margin-right: 4dp; }
        .zzfx-top button.zzfx-play { width: 30dp; }
        .zzfx-info { display: block; flex: 1 1 auto; margin-left: 4dp; color: #8b93a5; font-size: 11dp; white-space: nowrap; overflow: hidden; }
        .zzfx .notice { margin: 4dp 0dp; }
        .zzfx-wave { display: flex; flex-direction: row; height: 56dp; margin: 6dp 0dp; padding: 3dp 2dp; background-color: #121418; border: 1dp #2a2d36; border-radius: 3dp; }
        .zzfx-col { display: block; flex: 1 1 0dp; margin-right: 1dp; background-color: #5eead4; }
        .zzfx-row { display: flex; flex-direction: row; align-items: center; height: 26dp; }
        .zzfx-label { display: block; width: 52dp; color: #8b93a5; font-size: 11dp; }
        .zzfx-row button { width: 24dp; height: 22dp; line-height: 22dp; padding: 0dp; margin-right: 4dp; }
        .probe-bake { display: flex; flex-direction: row; align-items: center; height: 26dp; margin: 6dp 8dp; }
        .probe-bake button { width: 26dp; height: 22dp; line-height: 22dp; padding: 0dp; margin-right: 6dp; }
        .probe-bake-status { display: block; flex: 1 1 auto; color: #8b93a5; font-size: 11dp; white-space: nowrap; overflow: hidden; }
    </style>
</head>
<body class="panel-doc">
    <div class="panel-header">
        <span class="icon icon-adjustments-horizontal title-icon"></span>
        <span class="panel-title" id="inspector-title">Inspector</span>
        <div class="tabs">
            <button id="tab-properties" class="tool-button small active" data-tab="properties"
                    data-tooltip="Properties — the selected node's exported values"><span class="icon icon-adjustments-horizontal icon-sm"></span></button>
            <button id="tab-signals" class="tool-button small" data-tab="signals"
                    data-tooltip="Signals — connect the selected node's signals to methods of other nodes (saved in the scene)"><span class="icon icon-plug-connected icon-sm"></span></button>
        </div>
    </div>
    <div class="panel-body" id="inspector-body">
        <div class="empty"><span class="icon icon-lg icon-pointer icon-muted"></span><div>Select a node to edit its properties.</div></div>
    </div>
    <div class="label-splitter" id="label-splitter" data-tooltip="Name Column — drag to resize the property names (double-click: fit them)"></div>
    <div class="panel-body sig hidden" id="signals-body">
        <div class="empty">Select a node to see its signals.</div>
    </div>
</body>
</rml>
