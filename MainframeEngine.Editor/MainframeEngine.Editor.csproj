<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Mainframe Editor (M10, docs/design/editor.md): a separate executable whose only engine dependency is the
      MainframeEngine core library. Its UI is RmlUi documents (Assets/Editor) on the engine's UiServer.
      The release workflow publishes this exact project (docs/design/release.md); keep the path and assembly name.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>MainframeEngine.Editor</AssemblyName>
        <RootNamespace>MainframeEngine.Editor</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>..\docs\images\brand\logo.ico</ApplicationIcon>
        <!--
          CA1515 (make public types internal) targets application assemblies nobody references. The editor's API is
          public on purpose: its tests drive it, and game assemblies implement ICustomInspector / [CustomInspector].
        -->
        <NoWarn>$(NoWarn);CA1515</NoWarn>
        <!-- CA1716 (VB/F# keywords as member names): IEditorAction.Do/Undo are the names of the editor design (editor.md). -->
        <NoWarn>$(NoWarn);CA1716</NoWarn>
        <!-- The editor app's product name (Windows exe metadata); the engine and every other project keep the
             repo-wide "Mainframe Engine" from Directory.Build.props. -->
        <Product>Mainframe Editor</Product>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\MainframeEngine\MainframeEngine.csproj" />
        <!-- Video mode (docs/design/video-editor.md): Cutback's logic, editor-only; games never reference it. -->
        <ProjectReference Include="..\MainframeEngine.Video\MainframeEngine.Video.csproj" />
        <!--
          No MainframeEngine.Generators analyzer on purpose: editor nodes are tools, never serialized, and must not
          appear in the Add Node dialog (which lists the registered node types).
        -->
    </ItemGroup>

    <ItemGroup>
        <None Update="Assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!--
      The mfgame template ships with the published editor (Templates/mfgame, TemplateLocator.PackagedTemplateRelativePath),
      so a release editor creates package-based games without an engine checkout. Development runs use the checkout's.
    -->
    <ItemGroup>
        <None Include="..\Templates\MainframeEngine.Templates\content\mfgame\**"
              Exclude="..\Templates\MainframeEngine.Templates\content\mfgame\**\bin\**;..\Templates\MainframeEngine.Templates\content\mfgame\**\obj\**"
              Link="Templates\mfgame\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <!--
      Editor-only natives (docs/design/natives.md, ADR 0146): the music editor's helper executable mfplughost, built by
      Native/ (natives.yml) into runtimes/<rid>/native/ and copied next to the editor. The macOS and Linux files share
      one name, so a RID-agnostic build copies the host OS's RID only (macOS: the universal osx-arm64 file); a RID-specific
      build (publish) copies that RID's. A RID without a binary is skipped: the editor then renders .wav, no VST3.
      .NET's file copy keeps the Unix exec bit; PluginHostClient restores it if a copy lost it.
    -->
    <ItemGroup>
        <None Update="runtimes\**" CopyToOutputDirectory="Never" />
    </ItemGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
        <_MainframeEditorNativeRid Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-arm64</_MainframeEditorNativeRid>
        <_MainframeEditorNativeRid Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</_MainframeEditorNativeRid>
        <_MainframeEditorNativeRid Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</_MainframeEditorNativeRid>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <_MainframeEditorNativeRid>$(RuntimeIdentifier)</_MainframeEditorNativeRid>
    </PropertyGroup>
    <ItemGroup>
        <None Update="runtimes\$(_MainframeEditorNativeRid)\native\*"
              Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>

    <!-- Debug builds record this project's Assets folder so the editor UI loads (and hot-reloads) from the sources. -->
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>MainframeContentSource</_Parameter1>
            <_Parameter2>$(MSBuildProjectDirectory)/Assets</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="MainframeEngine.Editor.Tests" />
    </ItemGroup>

    <!--
      The editor and the engine core ship in lock step (one version: docs/design/release.md). Both get $(Version) from
      Directory.Build.props or the release's global -p:Version; this fails the build if either project overrides it.
      EditorBrand.VersionsMatch catches what a build cannot (a hand-copied MainframeEngine.dll) at startup.
    -->
    <Target Name="CheckEngineVersionLockStep" BeforeTargets="CoreCompile">
        <MSBuild Projects="..\MainframeEngine\MainframeEngine.csproj" Targets="GetMainframeVersion">
            <Output TaskParameter="TargetOutputs" PropertyName="_MainframeEngineCoreVersion" />
        </MSBuild>
        <Error Condition="'$(_MainframeEngineCoreVersion)' != '$(Version)'"
               Text="The editor ($(Version)) and the engine core ($(_MainframeEngineCoreVersion)) must have the same version. Set it only in Directory.Build.props or with -p:Version." />
    </Target>

    <!-- macOS: builds bin/<cfg>/net10.0/Mainframe Editor.app and makes `dotnet run` start the editor from inside it, so
         the Dock and menu bar say "Mainframe Editor" instead of the executable name (ADR 0096). build/package-editor.sh
         writes the same values into the release bundle. -->
    <PropertyGroup>
        <MacAppDisplayName>Mainframe Editor</MacAppDisplayName>
        <MacAppBundleId>com.mainframegames.editor</MacAppBundleId>
        <MacAppIcon>../docs/images/brand/logo.icns</MacAppIcon>
    </PropertyGroup>
    <Import Project="..\build\macos\DevAppBundle.targets" />

    <!-- macOS release: an osx publish writes the apphost of the release bundle (Contents/MacOS), which starts the editor
         from Contents/MonoBundle (build/macos/BundleAppHost.targets, build/package-editor.sh). -->
    <PropertyGroup>
        <MacBundleAppDirectory>MonoBundle</MacBundleAppDirectory>
    </PropertyGroup>
    <Import Project="..\build\macos\BundleAppHost.targets" />

</Project>
