<rml>
<head>
    <title>Video</title>
    <link type="text/rcss" href="/Assets/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* Video mode (docs/design/future/video-nle.md): the media pool, the Source and Timeline viewers and the Inspector on
           top; the notice line; the track headers beside the timeline canvas; the cut editor of the selected clip. The
           viewers and canvases are images of sub-viewports (VideoView) and let the mouse through to the VideoView node. */
        body.video-doc { background-color: #15171c; pointer-events: none; }
        #pool, #inspector, .viewer-bar, .viewer-head, #video-split-h, #video-notice, #video-notice-link, #headers, #cuts-head, #video-empty-actions { pointer-events: auto; }

        #video-top { display: flex; flex-direction: row; flex: 1 1 auto; min-height: 120dp; }
        .column { display: flex; flex-direction: column; overflow: hidden; background-color: #1b1d23; }
        .column-head, .viewer-head {
            display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; height: 26dp; padding: 0dp 6dp 0dp 8dp;
            background-color: #20232a; color: #d7dbe4; white-space: nowrap; overflow: hidden;
        }
        .column-head .title, .viewer-head .title { font-weight: bold; margin-right: 6dp; }
        .column-head .sub, .viewer-head .sub { color: #8b93a5; flex: 1 1 auto; overflow: hidden; }
        .column-head button.tool-button { width: 24dp; height: 22dp; }
        .gap { flex: 0 0 4dp; background-color: #15171c; }

        /* Media pool */
        #pool { flex: 0 0 auto; width: 240dp; }
        #pool-path { flex: 0 0 auto; height: 22dp; line-height: 22dp; padding: 0dp 8dp; color: #8b93a5; white-space: nowrap; overflow: hidden; cursor: pointer; }
        #pool-path:hover { color: #ffffff; }
        #pool-items { flex: 1 1 auto; overflow-y: auto; padding: 2dp 4dp; }
        .item { display: flex; flex-direction: row; align-items: center; height: 40dp; padding: 0dp 4dp; border-radius: 3dp; cursor: pointer; color: #d7dbe4; white-space: nowrap; overflow: hidden; }
        .item:hover { background-color: #262931; }
        .item.selected { background-color: #2f4f82; color: #ffffff; }
        .item .thumb { display: block; flex: 0 0 auto; width: 56dp; height: 32dp; margin-right: 8dp; border-radius: 2dp; background-color: #101114; }
        .item .glyph { display: flex; flex: 0 0 auto; width: 56dp; height: 32dp; margin-right: 8dp; align-items: center; justify-content: center; border-radius: 2dp; background-color: #101114; }
        .item .glyph .icon { image-color: #8b93a5; }
        .item .names { display: flex; flex-direction: column; flex: 1 1 auto; overflow: hidden; }
        .item .meta { color: #8b93a5; font-size: 11dp; }
        .pool-empty { padding: 10dp 8dp; color: #6b7488; line-height: 18dp; }

        /* Viewers */
        .viewer { display: flex; flex-direction: column; flex: 1 1 0dp; min-width: 120dp; background-color: #0b0c0f; }
        .viewer.focused .viewer-head { background-color: #26324a; }
        .view { display: block; position: relative; flex: 1 1 auto; overflow: hidden; pointer-events: none; }
        .view img { display: block; position: absolute; left: 0dp; top: 0dp; width: 100%; height: 100%; }
        .viewer-bar { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; height: 30dp; padding: 0dp 6dp; background-color: #1b1d23; }
        .viewer-bar button.tool-button { width: 26dp; height: 24dp; }
        .viewer-bar .time { margin: 0dp 8dp; color: #d7dbe4; white-space: nowrap; }
        .scrub { display: block; position: relative; flex: 1 1 auto; height: 16dp; margin: 0dp 6dp; border-radius: 3dp; background-color: #2a2d36; }
        .scrub .range { display: block; position: absolute; top: 0dp; height: 100%; background-color: #2f4f82; }
        .scrub .head { display: block; position: absolute; top: -2dp; width: 2dp; height: 20dp; background-color: #ff5c5c; }
        .viewer-empty { display: flex; flex: 1 1 auto; align-items: center; justify-content: center; color: #4b5263; text-align: center; padding: 0dp 12dp; }

        /* Inspector */
        #inspector { flex: 0 0 auto; width: 260dp; }
        #inspector-body { flex: 1 1 auto; overflow-y: auto; padding: 6dp 10dp; }
        .insp-tab { padding: 0dp 8dp; margin-right: 2dp; color: #8b93a5; cursor: pointer; border-radius: 3dp; }
        .insp-tab:hover { color: #d7dbe4; }
        .insp-tab.on { color: #ffffff; background-color: #262931; }
        #video-transcript { display: flex; flex-direction: column; flex: 1 1 auto; overflow: hidden; }
        #video-transcript-words { flex: 1 1 auto; overflow-y: auto; padding: 6dp 10dp; line-height: 20dp; }
        .transcript-empty { padding: 8dp 4dp; line-height: 18dp; color: #6b7488; }
        #video-transcript-words p { margin-bottom: 8dp; }
        .w { padding: 1dp 1dp; border-radius: 2dp; cursor: pointer; }
        .w:hover { background-color: #2a2d36; }
        .w.cut { color: #6a6a75; text-decoration: line-through; }
        .w.cur { background-color: #2f4f82; color: #ffffff; }
        .w.sel { background-color: #5b8def; color: #ffffff; }
        .section { display: block; margin: 8dp 0dp 4dp 0dp; color: #8b93a5; font-size: 11dp; }
        .row { display: flex; flex-direction: row; align-items: center; height: 26dp; color: #d7dbe4; }
        .row .label { flex: 0 0 auto; width: 76dp; color: #a3abbd; }
        .row input.text { flex: 1 1 auto; width: 60dp; height: 20dp; margin-right: 4dp; }
        .row .unit { flex: 0 0 auto; width: 18dp; color: #8b93a5; }
        .chips { display: flex; flex-direction: row; }
        .chip { padding: 2dp 8dp; margin-right: 4dp; border-radius: 3dp; background-color: #262931; color: #d7dbe4; cursor: pointer; }
        .chip:hover { background-color: #30343e; }
        .chip.on { background-color: #3b82f6; color: #ffffff; }
        .view img.off { visibility: hidden; } /* no texture published yet: an img without one draws white */
        .row input.wide { width: 180dp; }
        .note.warn { color: #fcd34d; }
        .note { display: block; margin-top: 8dp; color: #6b7488; line-height: 16dp; font-size: 11dp; }

        /* Notice */
        #video-notice {
            display: flex; flex-direction: row; align-items: center;
            flex: 0 0 auto; height: 22dp; line-height: 22dp; padding: 0dp 10dp;
            background-color: #3a2a0d; color: #fcd34d; font-size: 12dp; white-space: nowrap; overflow: hidden;
        }
        #video-notice-text { flex: 0 1 auto; overflow: hidden; white-space: nowrap; }
        #video-notice-link { flex: 0 0 auto; margin-left: 6dp; color: #ffffff; text-decoration: underline; cursor: pointer; }

        /* Timeline */
        .splitter { flex: 0 0 5dp; background-color: #15171c; drag: drag; }
        .splitter:hover, .splitter.dragging { background-color: #3b82f6; }
        #video-split-h { height: 5dp; cursor: ns-resize; }
        #video-timeline { display: flex; flex-direction: row; flex: 0 0 auto; height: 220dp; background-color: #121215; }
        #headers { display: block; position: relative; flex: 0 0 auto; width: 132dp; overflow: hidden; background-color: #1b1d23; }
        #headers-ruler { display: block; height: 24dp; line-height: 24dp; padding-left: 8dp; color: #8b93a5; font-size: 11dp; background-color: #18181c; }
        #headers-lanes { display: block; position: relative; }
        .track { display: flex; flex-direction: row; align-items: center; margin-top: 2dp; padding: 0dp 4dp 0dp 0dp; background-color: #20232a; overflow: hidden; }
        .track .target { flex: 0 0 auto; width: 4dp; height: 100%; margin-right: 6dp; background-color: transparent; }
        .track.target-on .target { background-color: #3b82f6; }
        .track .name { flex: 1 1 auto; color: #d7dbe4; cursor: pointer; }
        .track button.tool-button { width: 22dp; height: 20dp; margin-left: 1dp; }
        .track button.tool-button.on { background-color: #3b4253; }
        .track button.tool-button.on.solo { background-color: #b45309; }
        .track button.tool-button.on.mute { background-color: #7f1d1d; }
        #video-timeline-canvas { flex: 1 1 auto; }
        #video-cuts { display: flex; flex-direction: column; flex: 0 0 auto; height: 96dp; background-color: #121215; }
        #cuts-head { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; height: 20dp; padding: 0dp 8dp; background-color: #1b1d23; color: #8b93a5; font-size: 11dp; white-space: nowrap; overflow: hidden; }
        #video-cuts-canvas { flex: 1 1 auto; }

        #video-empty { display: flex; flex-direction: column; flex: 1 1 auto; align-items: center; justify-content: center; color: #6b7488; text-align: center; }
        #video-empty > .icon { margin-bottom: 8dp; image-color: #4b5263; }
        #video-empty-actions button { display: flex; flex-direction: row; align-items: center; }
        #video-empty-actions button .icon { margin-right: 6dp; }
        #video-empty-actions { display: flex; flex-direction: row; margin-top: 12dp; }
        #video-empty-actions button { margin: 0dp 4dp; }
    </style>
</head>
<body class="panel-doc video-doc" data-model="video">
    <div id="video-top">
        <div id="pool" class="column">
            <div class="column-head">
                <span class="title">Media pool</span><span class="sub"></span>
                <button class="tool-button small" id="pool-import" data-command="video.import" data-tooltip="Import Media (Ctrl+I) — copy files into this folder"><span class="icon icon-sm icon-file-import"></span></button>
                <button class="tool-button small" id="pool-timeline" data-command="video.new_timeline" data-tooltip="New Timeline — a new .mftimeline in Assets/Video/Timelines"><span class="icon icon-sm icon-timeline"></span></button>
                <button class="tool-button small" id="pool-folder" data-command="video.new_folder" data-tooltip="New Folder — a folder here in the media pool"><span class="icon icon-sm icon-folder-plus"></span></button>
            </div>
            <div id="pool-path" data-attr-data-pool-up="pool_up ? '1' : ''" data-tooltip="The media pool's folder; click to go up a level">{{pool_path}}</div>
            <div id="pool-items">
                <div class="pool-empty" data-if="pool_empty">Drop video, audio or images here from Finder, or Import Media.</div>
                <div class="item" data-for="it : pool" data-class-selected="it.selected" data-attr-data-pool="it.index" data-attr-data-tooltip="it.tip">
                    <img class="thumb" data-if="it.thumb != ''" data-attr-src="it.thumb"/>
                    <span class="glyph" data-if="it.thumb == ''"><span data-attr-class="'icon icon-' + it.icon"></span></span>
                    <div class="names"><span>{{it.name}}</span><span class="meta">{{it.meta}}</span></div>
                </div>
            </div>
        </div>
        <div class="gap"></div>
        <div id="video-empty" data-if="!has_tab">
            <span class="icon icon-lg icon-video"></span>
            <span>Open a timeline from the media pool, or start one.</span>
            <div id="video-empty-actions">
                <button data-command="video.new_timeline"><span class="icon icon-sm icon-timeline"></span><span>New Timeline</span></button>
                <button data-command="video.import"><span class="icon icon-sm icon-file-import"></span><span>Import Media</span></button>
            </div>
        </div>
        <div id="source" class="viewer" data-if="has_tab" data-class-focused="source_focused">
            <div class="viewer-head"><span class="title">Source</span><span class="sub">{{source_name}}</span></div>
            <div id="source-view" class="view"><img id="source-image" class="off"/></div>
            <div class="viewer-bar">
                <button class="tool-button small" id="source-play" data-command="video.source_play" data-tooltip="Play / Pause the Source viewer (Space when it is focused)"><span data-attr-class="source_playing ? 'icon icon-sm icon-player-pause' : 'icon icon-sm icon-player-play'"></span></button>
                <div id="source-bar" class="scrub"><span class="range" data-style-left="source_in_pct + '%'" data-style-width="source_range_pct + '%'"></span><span class="head" data-style-left="source_pos_pct + '%'"></span></div>
                <span class="time mono">{{source_time}}</span>
                <button class="tool-button small" id="source-in" data-command="video.mark_in" data-tooltip="Mark In (I)"><span class="icon icon-sm icon-arrow-bar-to-right"></span></button>
                <button class="tool-button small" id="source-out" data-command="video.mark_out" data-tooltip="Mark Out (O)"><span class="icon icon-sm icon-arrow-bar-to-left"></span></button>
                <button class="tool-button small" id="source-insert" data-command="video.insert" data-tooltip="Insert (,) — the marked range at the playhead; later clips move along"><span class="icon icon-sm icon-column-insert-right"></span></button>
                <button class="tool-button small" id="source-overwrite" data-command="video.overwrite" data-tooltip="Overwrite (.) — the marked range at the playhead, over what is there"><span class="icon icon-sm icon-replace"></span></button>
            </div>
        </div>
        <div class="gap" data-if="has_tab"></div>
        <div id="program" class="viewer" data-if="has_tab" data-class-focused="!source_focused">
            <div class="viewer-head"><span class="title">Timeline</span><span class="sub">{{program_title}}</span></div>
            <div id="program-view" class="view"><img id="program-image" class="off"/></div>
            <div class="viewer-bar">
                <button class="tool-button small" id="program-play" data-command="video.play" data-tooltip="Play / Pause the timeline (Space)"><span data-attr-class="program_playing ? 'icon icon-sm icon-player-pause' : 'icon icon-sm icon-player-play'"></span></button>
                <button class="tool-button small" id="program-prev" data-command="video.prev_edit" data-tooltip="Previous edit (Up)"><span class="icon icon-sm icon-player-track-prev"></span></button>
                <button class="tool-button small" id="program-next" data-command="video.next_edit" data-tooltip="Next edit (Down)"><span class="icon icon-sm icon-player-track-next"></span></button>
                <span class="time mono">{{program_time}}</span>
            </div>
        </div>
        <div class="gap" data-if="has_tab"></div>
        <div id="inspector" class="column" data-if="has_tab">
            <div class="column-head">
                <span class="insp-tab title" data-class-on="!insp_transcript" data-command="video.show_inspector" data-tooltip="Inspector — the selected clip's frame, or the timeline's settings">Inspector</span>
                <span class="insp-tab title" data-class-on="insp_transcript" data-command="video.show_transcript" data-tooltip="Transcript — the selected clip's words: click to cut or restore, drag for a run, Cmd+click to play from a word"><span class="icon icon-sm icon-file-text"></span> Transcript</span>
                <span class="sub">{{insp_title}}</span>
            </div>
            <div id="video-transcript" data-if="insp_transcript"><div id="video-transcript-words"></div></div>
            <div id="inspector-body" data-if="!insp_transcript">
                <div data-if="insp_mode == 'none'" class="note">Open a timeline from the media pool, or make one with New Timeline.</div>
                <div data-if="insp_mode == 'timeline'">
                    <div class="section">Timeline</div>
                    <div class="row"><span class="label">Size</span><input type="text" class="text mono" data-field="width" data-attr-value="t_width"/><span class="unit">×</span><input type="text" class="text mono" data-field="height" data-attr-value="t_height"/></div>
                    <div class="row"><span class="label">Preset</span><div class="chips"><span class="chip" data-event-click="preset(0)" data-tooltip="1080×1920: TikTok, Reels, Shorts">9:16</span><span class="chip" data-event-click="preset(1)" data-tooltip="1920×1080">16:9</span><span class="chip" data-event-click="preset(2)" data-tooltip="1080×1080">1:1</span><span class="chip" data-event-click="preset(3)" data-tooltip="3840×2160">4K</span></div></div>
                    <div class="row"><span class="label">Frame rate</span><div class="chips"><span class="chip" data-for="r : rates" data-class-on="r.on" data-event-click="rate(r.index)">{{r.name}}</span></div></div>
                    <div class="row"><span class="label">Background</span><input type="text" class="text mono" data-field="background" data-attr-value="t_background"/></div>
                    <div class="row"><span class="label">In / out</span><span class="mono">{{t_inout}}</span></div>
                    <div class="note">Select a clip to reframe it. I and O set in and out at the playhead; export can use them.</div>
                </div>
                <div data-if="insp_mode == 'video'">
                    <div class="section">Frame</div>
                    <div class="row"><span class="label">Fit</span><div class="chips"><span class="chip" data-class-on="c_fit == 0" data-event-click="fit(0)" data-tooltip="Fit — the whole frame shows, with bars">Fit</span><span class="chip" data-class-on="c_fit == 1" data-event-click="fit(1)" data-tooltip="Fill — the frame is covered, the overflow cropped">Fill</span><span class="chip" data-class-on="c_fit == 2" data-event-click="fit(2)" data-tooltip="Stretch — both axes to the frame, distorted">Stretch</span></div></div>
                    <div class="row"><span class="label">Scale</span><input type="text" class="text mono" data-field="scale" data-attr-value="c_scale"/><span class="unit">%</span></div>
                    <div class="row"><span class="label">Position</span><input type="text" class="text mono" data-field="x" data-attr-value="c_x"/><input type="text" class="text mono" data-field="y" data-attr-value="c_y"/></div>
                    <div class="row"><span class="label">Crop L / R</span><input type="text" class="text mono" data-field="crop_l" data-attr-value="c_crop_l"/><input type="text" class="text mono" data-field="crop_r" data-attr-value="c_crop_r"/></div>
                    <div class="row"><span class="label">Crop T / B</span><input type="text" class="text mono" data-field="crop_t" data-attr-value="c_crop_t"/><input type="text" class="text mono" data-field="crop_b" data-attr-value="c_crop_b"/></div>
                    <div class="row"><span class="label">Opacity</span><input type="text" class="text mono" data-field="opacity" data-attr-value="c_opacity"/><span class="unit">%</span></div>
                    <div class="section">Clip</div>
                    <div class="row" data-if="!c_still"><span class="label">Source</span><span class="mono">{{c_window}}</span></div>
                    <div class="row" data-if="!c_still"><span class="label">Speed</span><input type="text" class="text mono" data-field="speed" data-attr-value="c_speed" data-tooltip="Speed — 25 % to 400 %; the clips after it move along"/><span class="unit">%</span></div>
                    <div class="row"><span class="label">Fade in / out</span><input type="text" class="text mono" data-field="fade_in" data-attr-value="c_fade_in" data-tooltip="Fade in from black, in seconds"/><input type="text" class="text mono" data-field="fade_out" data-attr-value="c_fade_out" data-tooltip="Fade out to black, in seconds"/></div>
                    <div class="row"><span class="label">Enabled</span><div class="chips"><span class="chip" data-class-on="c_enabled" data-event-click="toggle_enabled()">{{c_enabled ? 'On' : 'Off'}}</span></div></div>
                    <div class="note">Position is in timeline pixels from the centre. Crop is in source pixels. Fades also have handles on the clip's top corners.</div>
                </div>
                <div data-if="insp_mode == 'audio'">
                    <div class="section">Clip</div>
                    <div class="row"><span class="label">Source</span><span class="mono">{{c_window}}</span></div>
                    <div class="row"><span class="label">Volume</span><input type="text" class="text mono" data-field="volume" data-attr-value="c_volume" data-tooltip="The clip's volume, −60 to +24 dB, on top of its track's gain"/><span class="unit">dB</span></div>
                    <div class="row"><span class="label">Fade in / out</span><input type="text" class="text mono" data-field="fade_in" data-attr-value="c_fade_in" data-tooltip="Fade in from silence, in seconds"/><input type="text" class="text mono" data-field="fade_out" data-attr-value="c_fade_out" data-tooltip="Fade out to silence, in seconds"/></div>
                    <div class="row"><span class="label">Speed</span><input type="text" class="text mono" data-field="speed" data-attr-value="c_speed" data-tooltip="Speed — 25 % to 400 %, the pitch kept; its linked picture follows"/><span class="unit">%</span></div>
                    <div class="row"><span class="label">Enabled</span><div class="chips"><span class="chip" data-class-on="c_enabled" data-event-click="toggle_enabled()">{{c_enabled ? 'On' : 'Off'}}</span></div></div>
                    <div class="section">Track</div>
                    <div class="row"><span class="label">Gain</span><input type="text" class="text mono" data-field="gain" data-attr-value="c_gain"/><span class="unit">dB</span></div>
                </div>
                <div data-if="insp_mode == 'title'">
                    <div class="section">Text</div>
                    <div class="row"><span class="label">Text</span><input type="text" class="text wide" data-field="tt_text" data-attr-value="tt_text" data-tooltip="The title's text; type \\n for a new line"/></div>
                    <div class="row"><span class="label">Font</span><div class="chips"><span class="chip" data-class-on="tt_font == 0" data-event-click="title_font(0)" data-tooltip="Lato Bold">Bold</span><span class="chip" data-class-on="tt_font == 1" data-event-click="title_font(1)" data-tooltip="Lato Regular">Reg</span><span class="chip" data-class-on="tt_font == 2" data-event-click="title_font(2)" data-tooltip="Lato Italic">Ital</span><span class="chip" data-class-on="tt_font == 3" data-event-click="title_font(3)" data-tooltip="Roboto Mono">Mono</span></div></div>
                    <div class="row"><span class="label">Size</span><input type="text" class="text mono" data-field="tt_size" data-attr-value="tt_size"/><span class="unit">px</span></div>
                    <div class="row"><span class="label">Colour</span><input type="text" class="text mono" data-field="tt_color" data-attr-value="tt_color"/></div>
                    <div class="row"><span class="label">Align</span><div class="chips"><span class="chip" data-class-on="tt_align == 0" data-event-click="title_align(0)" data-tooltip="Lines start together"><span class="icon icon-sm icon-align-left"></span></span><span class="chip" data-class-on="tt_align == 1" data-event-click="title_align(1)" data-tooltip="Lines centred"><span class="icon icon-sm icon-align-center"></span></span><span class="chip" data-class-on="tt_align == 2" data-event-click="title_align(2)" data-tooltip="Lines end together"><span class="icon icon-sm icon-align-right"></span></span></div></div>
                    <div class="row"><span class="label">Position</span><input type="text" class="text mono" data-field="tt_x" data-attr-value="tt_x"/><input type="text" class="text mono" data-field="tt_y" data-attr-value="tt_y"/></div>
                    <div class="section">Style</div>
                    <div class="row"><span class="label">Outline</span><input type="text" class="text mono" data-field="tt_outline" data-attr-value="tt_outline"/><input type="text" class="text mono" data-field="tt_outline_color" data-attr-value="tt_outline_color"/></div>
                    <div class="row"><span class="label">Shadow</span><input type="text" class="text mono" data-field="tt_shadow" data-attr-value="tt_shadow" data-tooltip="Shadow opacity, %"/><input type="text" class="text mono" data-field="tt_shadow_x" data-attr-value="tt_shadow_x"/><input type="text" class="text mono" data-field="tt_shadow_y" data-attr-value="tt_shadow_y"/></div>
                    <div class="row"><span class="label">Box</span><div class="chips"><span class="chip" data-class-on="tt_box" data-event-click="title_box()">{{tt_box ? 'On' : 'Off'}}</span></div><input type="text" class="text mono" data-field="tt_box_color" data-attr-value="tt_box_color"/></div>
                    <div class="row"><span class="label">Box opacity</span><input type="text" class="text mono" data-field="tt_box_opacity" data-attr-value="tt_box_opacity"/><span class="unit">%</span><input type="text" class="text mono" data-field="tt_box_padding" data-attr-value="tt_box_padding" data-tooltip="Box padding, px"/></div>
                    <div class="section">Clip</div>
                    <div class="row"><span class="label">Fade in / out</span><input type="text" class="text mono" data-field="fade_in" data-attr-value="c_fade_in"/><input type="text" class="text mono" data-field="fade_out" data-attr-value="c_fade_out"/></div>
                    <div class="note">Sizes and positions are timeline pixels; position is the text's centre from the frame's. Colours are #RRGGBB.</div>
                </div>
                <div data-if="insp_mode == 'transition'">
                    <div class="section">Transition</div>
                    <div class="row"><span class="label">Kind</span><div class="chips"><span class="chip" data-class-on="tr_kind == 0" data-event-click="transition_kind(0)" data-tooltip="The pictures dissolve into each other and the sounds crossfade; needs frames past the edit">Dissolve</span><span class="chip" data-class-on="tr_kind == 1" data-event-click="transition_kind(1)" data-tooltip="Fade to black and back; the sound out and in">Dip to black</span></div></div>
                    <div class="row"><span class="label">Length</span><input type="text" class="text mono" data-field="tr_duration" data-attr-value="tr_duration"/><span class="unit">s</span></div>
                    <div class="note warn" data-if="tr_problem != ''">{{tr_problem}}</div>
                    <div class="row"><button class="tool-button" data-event-click="transition_remove()" data-tooltip="Remove the transition (Delete)"><span class="icon icon-trash"></span></button></div>
                </div>
            </div>
        </div>
    </div>
    <div id="video-notice" data-if="notice != ''" data-attr-data-tooltip="notice"><span id="video-notice-text">{{notice}}</span><span id="video-notice-link" data-if="notice_ffmpeg" data-command="video.settings" data-tooltip="Editor Settings › Video › ffmpeg — set where ffmpeg is">Editor Settings</span></div>
    <div id="video-split-h" class="splitter" data-if="has_tab"></div>
    <div id="video-timeline" data-if="has_tab">
        <div id="headers">
            <div id="headers-ruler">{{timecode}}</div>
            <div id="headers-lanes" data-style-top="headers_top + 'dp'">
                <div class="track" data-for="t : tracks" data-attr-data-track-row="t.id" data-class-target-on="t.target" data-style-height="t.height + 'dp'">
                    <span class="target"></span>
                    <span class="name" data-attr-data-track-target="t.id" data-tooltip="Click to make this the track Insert and Overwrite place on; right-click for more">{{t.name}}</span>
                    <button class="tool-button small" data-class-on="t.locked" data-attr-data-track-lock="t.id" data-tooltip="Lock — no edit touches this track"><span data-attr-class="t.locked ? 'icon icon-sm icon-lock' : 'icon icon-sm icon-lock-open'"></span></button>
                    <button class="tool-button small" data-if="t.video" data-class-on="!t.enabled" data-attr-data-track-eye="t.id" data-tooltip="Show / Hide — a hidden video track is not drawn"><span data-attr-class="t.enabled ? 'icon icon-sm icon-eye' : 'icon icon-sm icon-eye-off'"></span></button>
                    <button class="tool-button small mute" data-if="!t.video" data-class-on="t.muted" data-attr-data-track-mute="t.id" data-tooltip="Mute — this track is not heard"><span data-attr-class="t.muted ? 'icon icon-sm icon-volume-off' : 'icon icon-sm icon-volume'"></span></button>
                    <button class="tool-button small solo" data-if="!t.video" data-class-on="t.solo" data-attr-data-track-solo="t.id" data-tooltip="Solo — only soloed tracks are heard"><span class="icon icon-sm icon-headphones"></span></button>
                </div>
            </div>
        </div>
        <div id="video-timeline-canvas" class="view"><img id="timeline-image" class="off"/></div>
    </div>
    <div id="video-cuts" data-if="has_tab">
        <div id="cuts-head"><span>{{cuts_title}}</span></div>
        <div id="video-cuts-canvas" class="view"><img id="cuts-image" class="off"/></div>
    </div>
</body>
</rml>
