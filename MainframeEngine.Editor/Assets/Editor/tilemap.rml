<rml>
<head>
    <title>TileMap</title>
    <link type="text/rcss" href="/Assets/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        .panel-header .dock-tab:last-of-type { margin-right: 10dp; }
        .tools { display: flex; flex-direction: row; align-items: center; flex: 1 1 auto; justify-content: flex-end; }
        .tools .tool-button { margin-left: 3dp; }
        .tools .sep { display: block; width: 1dp; height: 16dp; margin: 0dp 5dp; background-color: #3b3f4b; }
        .tools .caption { color: #8b93a5; font-size: 11dp; margin: 0dp 4dp 0dp 6dp; }
        .tools input.num { width: 34dp; height: 18dp; margin-left: 2dp; padding: 1dp 4dp; font-size: 11dp; text-align: right; }
        .tm-main { display: flex; flex-direction: row; flex: 1 1 auto; min-height: 0dp; }
        .tm-sources { display: block; flex: 0 0 150dp; overflow-y: auto; border-right: 1dp #2f333d; padding: 4dp; }
        .tm-source {
            display: flex; flex-direction: row; align-items: center; height: 30dp; padding: 0dp 4dp; margin-bottom: 2dp;
            border-radius: 3dp; color: #c9cedb; font-size: 11dp; cursor: pointer; white-space: nowrap; overflow: hidden;
        }
        .tm-source:hover { background-color: #2a2e38; }
        .tm-source.active { background-color: #2f3a52; color: #ffffff; }
        .tm-source img { width: 24dp; height: 24dp; margin-right: 6dp; }
        .tm-source .id { color: #8b93a5; margin-right: 4dp; }
        .tm-source-tools { display: flex; flex-direction: row; margin-top: 4dp; }
        .tm-source-tools .tool-button { margin-right: 3dp; }
        .tm-atlas { display: block; flex: 1 1 auto; overflow: auto; background-color: #15171c; padding: 8dp; }
        .tm-sheet { position: relative; display: block; background-color: #2a2e38; }
        .tm-image { position: absolute; left: 0dp; top: 0dp; }
        .tm-cell { position: absolute; display: block; border: 1dp #ffffff22; }
        .tm-cell.missing { background-color: #0f1115b0; border-color: #ffffff10; }
        .tm-cell:hover { border-color: #93c5fd; }
        .tm-cell.picked { background-color: #3b82f640; border: 2dp #3b82f6; }
        .tm-cell.solid { border-color: #4ade8080; }
        .tm-side { display: block; flex: 0 0 230dp; overflow-y: auto; border-left: 1dp #2f333d; padding: 6dp; font-size: 11dp; color: #c9cedb; }
        .tm-side .heading { color: #8b93a5; margin: 6dp 0dp 3dp 0dp; }
        .tm-row { display: flex; flex-direction: row; align-items: center; margin-bottom: 3dp; }
        .tm-row .label { flex: 0 0 82dp; color: #a3abbd; overflow: hidden; white-space: nowrap; }
        .tm-row input.text { flex: 1 1 auto; height: 18dp; padding: 1dp 4dp; font-size: 11dp; }
        .tm-alts { display: flex; flex-direction: row; flex-wrap: wrap; }
        .tm-alt { display: block; width: 36dp; height: 36dp; margin: 0dp 4dp 4dp 0dp; border: 1dp #2f333d; border-radius: 3dp; cursor: pointer; }
        .tm-alt:hover { border-color: #93c5fd; }
        .tm-alt.active { border: 2dp #3b82f6; }
        .tm-alt img { width: 32dp; height: 32dp; margin: 1dp; }
        .tm-empty { color: #6b7488; padding: 12dp; }
        .tm-tile { position: relative; display: block; background-color: #2a2e38; margin-top: 4dp; }
        .tm-tile img { position: absolute; left: 0dp; top: 0dp; }
        .tm-snap { position: absolute; display: block; width: 7dp; height: 7dp; margin-left: -3dp; margin-top: -3dp; border-radius: 4dp; background-color: #ffffff30; cursor: pointer; }
        .tm-snap:hover { background-color: #93c5fd; }
        .tm-edge { position: absolute; display: block; height: 2dp; background-color: #4ade80; transform-origin: 0% 50%; }
        .tm-point { position: absolute; display: block; width: 9dp; height: 9dp; margin-left: -4dp; margin-top: -4dp; border-radius: 2dp; background-color: #4ade80; border: 1dp #052e16; cursor: pointer; }
        .tm-point.active { background-color: #fbbf24; }
        .tm-point.drawing { background-color: #fbbf24; }
    </style>
</head>
<body class="panel-doc">
    <div class="panel-header">
        <button class="dock-tab" data-tab="0" data-tooltip="Output — the editor's and the running games' log"><span class="icon icon-sm icon-terminal-2"></span><span class="label">Output</span></button>
        <button class="dock-tab" data-tab="1" data-tooltip="Profiler — frame times, scopes and GPU zones of a running game or the editor"><span class="icon icon-sm icon-activity"></span><span class="label">Profiler</span></button>
        <button class="dock-tab" id="tm-tab-map" data-tab="2" data-tooltip="TileMap — pick the tiles the paint tools put down (shown while a TileMapLayer is selected)"><span class="icon icon-sm icon-grid-pattern"></span><span class="label">TileMap</span></button>
        <button class="dock-tab" id="tm-tab-set" data-tab="3" data-tooltip="TileSet — atlas sources, tiles, tile data and collision of the edited tile set"><span class="icon icon-sm icon-layout-grid"></span><span class="label">TileSet</span></button>
        <div class="tools" id="tm-tools"></div>
    </div>
    <div class="tm-main">
        <div class="tm-sources" id="tm-sources"></div>
        <div class="tm-atlas" id="tm-atlas"></div>
        <div class="tm-side" id="tm-side"></div>
    </div>
</body>
</rml>
