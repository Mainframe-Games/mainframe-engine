<rml>
<head>
    <title>Export Video</title>
    <link type="text/rcss" href="/Assets/icons/icons.rcss"/>
    <link type="text/rcss" href="theme.rcss"/>
    <link type="text/rcss" href="dialogs.rcss"/>
    <style>
        #dialog { left: 50%; top: 50%; width: 560dp; height: 276dp; margin-left: -280dp; margin-top: -138dp; }
        .dialog-row .caption { width: 100dp; }
        .dialog-row button { width: 26dp; padding: 0dp; margin-left: 6dp; }
        #ev-summary { display: block; flex: 0 0 auto; margin-bottom: 10dp; color: #b4bccc; }
        .mode-row { display: flex; flex-direction: row; align-items: center; flex: 0 0 auto; height: 24dp; padding: 0dp 6dp; border-radius: 3dp; cursor: pointer; color: #d7dbe4; }
        .mode-row:hover { background-color: #2a2e38; }
        .mode-row .radio { display: block; flex: 0 0 auto; width: 10dp; height: 10dp; margin-right: 9dp; border-radius: 7dp; border: 2dp #6b7488; }
        .mode-row.selected .radio { background-color: #3b82f6; border-color: #3b82f6; }
        .mode-row.disabled { color: #6b7488; cursor: default; }
        .mode-row.disabled:hover { background-color: transparent; }
        .hint { display: block; flex: 0 0 auto; margin: 2dp 0dp 0dp 25dp; color: #8b93a5; font-size: 11dp; }
    </style>
</head>
<body class="backdrop" data-model="video_export">
    <div class="dialog" id="dialog">
        <div class="dialog-title"><span class="icon icon-sm icon-download"></span><span>Export Video</span></div>
        <div class="dialog-body">
            <div id="ev-summary">{{summary}}</div>
            <div class="dialog-row">
                <span class="caption">Output file</span>
                <input type="text" class="text mono" id="ev-path" data-value="path"/>
                <button id="ev-browse" data-event-click="browse()" data-tooltip="Browse — choose where to save the exported video"><span class="icon icon-sm icon-folder-open"></span></button>
            </div>
            <div class="mode-row" id="ev-precise" data-class-selected="!fast" data-event-click="choose(0)">
                <span class="radio"></span><span>Precise (re-encode, frame-accurate)</span>
            </div>
            <div class="mode-row" id="ev-fast" data-class-selected="fast" data-class-disabled="!fast_allowed" data-event-click="choose(1)">
                <span class="radio"></span><span>Fast (copy, approximate: cuts snap back to keyframes)</span>
            </div>
            <div class="hint" id="ev-hint">{{hint}}</div>
            <div class="dialog-error" id="ev-error">{{error}}</div>
        </div>
        <div class="dialog-buttons">
            <button id="ev-cancel" data-event-click="cancel()">Cancel</button>
            <button class="primary" id="ev-export" data-event-click="export()">Export</button>
        </div>
    </div>
</body>
</rml>
