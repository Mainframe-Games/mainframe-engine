<rml>
<head>
    <title>Splash</title>
    <link type="text/rcss" href="theme.rcss"/>
    <style>
        /* The start-up splash (brand navy over everything) and, with .panel, the loading window over the editor. */
        body.splash {
            position: absolute;
            left: 0dp;
            top: 0dp;
            width: 100%;
            height: 100%;
            background-color: #172554;
            pointer-events: auto;
            opacity: 1;
            transition: opacity 0.35s cubic-out;
        }
        body.splash.done { opacity: 0; }
        #center {
            position: absolute;
            left: 50%;
            top: 46%;
            width: 420dp;
            margin-left: -210dp;
            margin-top: -190dp;
            text-align: center;
        }
        #logo { display: block; width: 168dp; height: 168dp; margin: 0dp auto 22dp auto; }
        #wordmark {
            display: block;
            font-size: 34dp;
            font-weight: bold;
            letter-spacing: 1dp;
            color: #ffffff;
        }
        #version {
            display: block;
            margin-top: 6dp;
            font-size: 14dp;
            color: #93c5fd;
        }
        #title {
            display: none;
            margin-top: 34dp;
            height: 18dp;
            font-size: 14dp;
            font-weight: bold;
            color: #ffffff;
        }
        body.titled #title { display: block; }
        #status {
            display: block;
            margin-top: 34dp;
            height: 18dp;
            font-size: 13dp;
            color: #bfdbfe;
        }
        #bar {
            display: block;
            width: 260dp;
            height: 3dp;
            margin: 10dp auto 0dp auto;
            background-color: #1e3a8a;
            border-radius: 2dp;
        }
        #fill {
            display: block;
            width: 0%;
            height: 3dp;
            background-color: #38bdf8;
            border-radius: 2dp;
        }
        #meta {
            display: flex;
            flex-direction: row;
            justify-content: space-between;
            width: 260dp;
            height: 16dp;
            margin: 6dp auto 0dp auto;
            font-size: 11dp;
            color: #93c5fd;
        }
        #actions { display: block; height: 26dp; margin-top: 14dp; }
        #cancel { height: 24dp; line-height: 24dp; padding: 0dp 16dp; }
        body.titled #status { margin-top: 6dp; }
        .hidden { visibility: hidden; }

        /* The loading window: a card over the dimmed editor. */
        body.splash.panel { background-color: #0008; }
        body.panel #center {
            top: 40%;
            width: 440dp;
            margin-left: -220dp;
            margin-top: -70dp;
            padding: 16dp 18dp 14dp 18dp;
            background-color: #1f2128;
            border: 1dp #3b3f4b;
            border-radius: 6dp;
            box-shadow: #000000a0 0dp 10dp 30dp 0dp;
            text-align: left;
        }
        body.panel #logo, body.panel #wordmark, body.panel #version { display: none; }
        body.panel #title { margin-top: 0dp; color: #ffffff; }
        body.panel #status { color: #d7dbe4; }
        body.panel #bar { width: 100%; height: 4dp; margin: 12dp 0dp 0dp 0dp; background-color: #2f333d; }
        body.panel #fill { height: 4dp; background-color: #3b82f6; }
        body.panel #meta { width: 100%; margin: 6dp 0dp 0dp 0dp; color: #8b93a5; }
        body.panel #actions { text-align: right; margin-top: 10dp; }
    </style>
</head>
<body class="splash">
    <div id="center">
        <img id="logo" src="/Assets/Brand/logo-512.png"/>
        <div id="wordmark">Mainframe Editor</div>
        <div id="version"></div>
        <div id="title"></div>
        <div id="status">Loading…</div>
        <div id="bar"><div id="fill"></div></div>
        <div id="meta"><span id="detail"></span><span id="elapsed"></span></div>
        <div id="actions"><button id="cancel" class="hidden">Cancel</button></div>
    </div>
</body>
</rml>
