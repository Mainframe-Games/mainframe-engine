<Project Sdk="Microsoft.NET.Sdk">

  <!--
    mfe: the Mainframe engine/editor command-line tool (docs/design/animation.md#the-mfe-cli). Its first command group is
    `anim` (G1c animation authoring: rig, poses, bake, describe, check, list). Run with `just mfe …`, or
    `dotnet run` on this project (arguments after a double dash) from a game project.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mfe</AssemblyName>
    <RootNamespace>MainframeEngine.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MainframeEngine.Tests" />
  </ItemGroup>

</Project>
