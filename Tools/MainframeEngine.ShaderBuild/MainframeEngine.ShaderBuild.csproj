<Project Sdk="Microsoft.NET.Sdk">

  <!--
    mf-shaders: builds game surface shaders (ADR 0237: .slang files starting with `import mainframe.spatial;` or
    `import mainframe.canvas;`; other .slang files are helper modules). Reads each one's layout from slangc's reflection
    (SlangReflection), compiles every pass's generated entry (SurfaceShaderCompiler) and writes x.slang.{vert,frag}.spv (a
    spatial shader also .depth, .shadow, .shadow-point and .id pairs), x.slang.mflayout.json and x.slang.mfspvlock next to the
    source (committed, like the engine's own shaders). `check` fails when any is stale (CI without slangc).
      just canvas-shaders FOLDER (build) / just canvas-shaders-check FOLDER
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mf-shaders</AssemblyName>
    <RootNamespace>MainframeEngine.ShaderBuild</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
  </ItemGroup>

</Project>
