<Project Sdk="Microsoft.NET.Sdk">

  <!--
    mf-shaders: builds the SPIR-V of shaders written in Godot's shading language (.gdshader): canvas_item (ADR 0113) and
    spatial (ADR 0205). Translates each with CanvasShaderCompiler / SpatialShaderCompiler, compiles the stages with slangc and
    writes x.gdshader.{vert,frag}.spv (a spatial shader also .depth, .shadow, .shadow-point and .id pairs) + x.gdshader.spvlock
    next to the source (committed, like the engine's own shaders). `check` fails when any is stale (CI without slangc).
      just canvas-shaders FOLDER (build) / just canvas-shaders-check FOLDER
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>mf-shaders</AssemblyName>
    <RootNamespace>MainframeEngine.ShaderBuild</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MainframeEngine\MainframeEngine.csproj" />
  </ItemGroup>

</Project>
